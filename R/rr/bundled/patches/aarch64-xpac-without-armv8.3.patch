Encode XPACD/XPACI by hand, so that rr builds without -march=armv8.3-a.
They only execute when replaying traces recorded with pointer authentication.
Not reported upstream: upstream builds with -march=armv8.3-a.

--- a/src/ExtraRegisters.cc
+++ b/src/ExtraRegisters.cc
@@ -280,13 +280,15 @@
                          sizeof(uint32_t));
 #ifdef __aarch64__
     } else if (regno == DREG_PAUTH_DMASK || regno == DREG_PAUTH_CMASK) {
-      uint64_t ptr = 1ULL << 55;
+      // XPACD/XPACI are ARMv8.3 instructions: encode them by hand so that rr
+      // can be built for older CPUs. They only run for traces recorded with PAuth.
+      register uint64_t ptr __asm__("x0") = 1ULL << 55;
       // The XPAC instruction will copy bit 55 of the argument into the PAC mask
       // bits, so ptr will be set to the mask plus bit 55.
       if (regno == DREG_PAUTH_DMASK) {
-        __asm__ __volatile__("xpacd %0" : "+r"(ptr));
+        __asm__ __volatile__(".inst 0xdac147e0 // xpacd x0" : "+r"(ptr));
       } else {
-        __asm__ __volatile__("xpaci %0" : "+r"(ptr));
+        __asm__ __volatile__(".inst 0xdac143e0 // xpaci x0" : "+r"(ptr));
       }
       uint64_t mask = ptr & ~(1ULL << 55);
       *defined = true;
