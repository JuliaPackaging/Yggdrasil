julia-gc: Stop using Julia write barriers whose API changed

Backport of gap-system/gap#6587 to v4.16.1; drop it once GAP is updated
to v4.17.0.

Julia 1.14 adds a third argument to `jl_gc_wb`, the address of the slot
being written (JuliaLang/julia#62737), and renames `jl_gc_wb_back` to
`jl_gc_wb_object` (JuliaLang/julia#63299).

Call `jl_gc_wb_object` instead of `jl_gc_wb`, and map it to
`jl_gc_wb_back` for Julia before 1.14. It skips the check whether the
stored value is young, so at worst it puts an old object into the
remembered set needlessly.

Upstream puts the compatibility macro in `src/gasman.h`, which by then
includes `<julia.h>`. In v4.16.1 no installed header includes Julia
headers, and `gac` does not put Julia's include dir on the search path,
so the macro must not go into a header: it is defined in the two `.c`
files that use it, after their `<julia.h>` include.

diff --git a/src/julia_gc.c b/src/julia_gc.c
index 568b567..987113a 100644
--- a/src/julia_gc.c
+++ b/src/julia_gc.c
@@ -43,6 +43,11 @@
 #include <julia_gcext.h>
 #include <julia_threads.h>    // for jl_get_ptls_states
 
+// Julia 1.14 renamed `jl_gc_wb_back` to `jl_gc_wb_object`
+// (JuliaLang/julia#63299).
+#if JULIA_VERSION_MAJOR == 1 && JULIA_VERSION_MINOR < 14
+#define jl_gc_wb_object jl_gc_wb_back
+#endif
 
 /****************************************************************************
 **
@@ -871,15 +876,15 @@ BOOL IsGapObj(void * p)
 
 void CHANGED_BAG(Bag bag)
 {
-    jl_gc_wb_back(BAG_HEADER(bag));
+    jl_gc_wb_object(BAG_HEADER(bag));
 }
 
 void SwapMasterPoint(Bag bag1, Bag bag2)
 {
     SWAP(UInt *, bag1->body, bag2->body);
 
-    jl_gc_wb((void *)bag1, BAG_HEADER(bag1));
-    jl_gc_wb((void *)bag2, BAG_HEADER(bag2));
+    jl_gc_wb_object((void *)bag1);
+    jl_gc_wb_object((void *)bag2);
 }
 
 UInt CollectBags(UInt size, UInt full)
@@ -970,7 +975,7 @@ Bag NewBag(UInt type, UInt size)
 
     // change the masterpointer to reference the new bag memory
     bag->body = header + 1;
-    jl_gc_wb_back((void *)bag);
+    jl_gc_wb_object((void *)bag);
 
     // return the identifier of the new bag
     return bag;
@@ -1004,7 +1009,7 @@ UInt ResizeBag(Bag bag, UInt new_size)
 
         // update the master pointer
         bag->body = header + 1;
-        jl_gc_wb_back((void *)bag);
+        jl_gc_wb_object((void *)bag);
     }
 
     // update the size
diff --git a/src/weakptr.c b/src/weakptr.c
index 8d27774..9895dcf 100644
--- a/src/weakptr.c
+++ b/src/weakptr.c
@@ -40,6 +40,12 @@
