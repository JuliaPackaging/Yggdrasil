diff --git a/opcodes/configure b/opcodes/configure
index fa81f1d6..706a3af7 100755
--- a/opcodes/configure
+++ b/opcodes/configure
@@ -12447,6 +12447,14 @@ if test "$enable_shared" = "yes"; then
       SHARED_LDFLAGS="-no-undefined"
       SHARED_LIBADD="-L`pwd`/../bfd -lbfd -L`pwd`/../libiberty -liberty $SHARED_LIBADD"
       ;;
+    *-*-mingw*)
+      # Don't re-export the static libiberty/libintl linked into the DLL; programs link those too.
+      SHARED_LDFLAGS="-no-undefined -Wl,--exclude-libs,ALL"
+      # There is no libc to name in `-Wl,-lc,--as-needed,...` below; link libm directly.
+      bfd_cv_ld_as_needed=no
+      SHARED_LIBADD="../bfd/libbfd.la -L`pwd`/../libiberty -liberty ${SHARED_LIBADD}"
+      SHARED_DEPENDENCIES="../bfd/libbfd.la"
+      ;;
     *)
       SHARED_LIBADD="../bfd/libbfd.la ${SHARED_LIBADD}"
       SHARED_DEPENDENCIES="../bfd/libbfd.la"
