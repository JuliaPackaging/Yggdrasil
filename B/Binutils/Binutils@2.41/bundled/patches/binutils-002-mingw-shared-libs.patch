Build shared libbfd, libopcodes, libctf and libsframe DLLs on mingw.

Libtool only builds a Windows DLL for libraries linked with `-no-undefined`, and upstream
passes that (together with an explicit libiberty) only for Cygwin hosts.

diff --git a/bfd/configure b/bfd/configure
index 910af3ce..29bba850 100755
--- a/bfd/configure
+++ b/bfd/configure
@@ -13720,6 +13720,13 @@ if test "$enable_shared" = "yes"; then
     SHARED_LDFLAGS="-no-undefined"
     SHARED_LIBADD="-L`pwd`/../libiberty -liberty $SHARED_LIBADD -lcygwin -lkernel32"
   ;;
+  *-*-mingw*)
+    # Don't re-export the static libiberty/libintl linked into the DLL; programs link those too.
+    SHARED_LDFLAGS="-no-undefined -Wl,--exclude-libs,ALL"
+    # There is no libc to name in `-Wl,-lc,--as-needed,...` below; link libm directly.
+    bfd_cv_ld_as_needed=no
+    SHARED_LIBADD="-L`pwd`/../libiberty -liberty $SHARED_LIBADD"
+  ;;
   esac
 
   if test -n "$SHARED_LIBADD"; then
