+; RUN: not llvm-spirv %s -o %t.spv 2>&1 | FileCheck %s
+
+; CHECK: InvalidFunctionCall: Unexpected llvm intrinsic:
+; CHECK-NEXT: i1 operands are not supported.
+
+target triple = "spir64-unknown-unknown"
