 lib/Target/SPIRV/SPIRVUtils.cpp               |  4 +++
 .../atomicrmw-storage-class-semantics.ll      | 10 ++++++
 test/CodeGen/SPIRV/fence-shader.ll            | 34 ++++++++++++++++++
 test/CodeGen/SPIRV/fence.ll                   | 36 +++++++++++++------
 .../AtomicCompareExchangeExplicit_cl20.ll     | 17 ++++-----
 .../transcoding/AtomicCompareExchange_cl20.ll |  2 +-
 7 files changed, 92 insertions(+), 20 deletions(-)
 create mode 100644 llvm/test/CodeGen/SPIRV/fence-shader.ll

diff --git a/lib/Target/SPIRV/SPIRVInstructionSelector.cpp b/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
index 6d91335fc41e..7955036e511d 100644
--- a/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
+++ b/lib/Target/SPIRV/SPIRVInstructionSelector.cpp
@@ -2609,7 +2609,14 @@ bool SPIRVInstructionSelector::selectUnmergeValues(MachineInstr &I) const {
 
 bool SPIRVInstructionSelector::selectFence(MachineInstr &I) const {
   AtomicOrdering AO = AtomicOrdering(I.getOperand(0).getImm());
-  uint32_t MemSem = static_cast<uint32_t>(getMemSemantics(AO));
+  uint32_t ScSem = STI.isShader()
+                       ? SPIRV::MemorySemantics::UniformMemory |
+                             SPIRV::MemorySemantics::WorkgroupMemory |
+                             SPIRV::MemorySemantics::ImageMemory
+                       : SPIRV::MemorySemantics::WorkgroupMemory |
+                             SPIRV::MemorySemantics::CrossWorkgroupMemory |
+                             SPIRV::MemorySemantics::ImageMemory;
+  uint32_t MemSem = static_cast<uint32_t>(getMemSemantics(AO)) | ScSem;
   Register MemSemReg = buildI32Constant(MemSem, I);
   SyncScope::ID Ord = SyncScope::ID(I.getOperand(1).getImm());
   uint32_t Scope = static_cast<uint32_t>(
diff --git a/lib/Target/SPIRV/SPIRVUtils.cpp b/lib/Target/SPIRV/SPIRVUtils.cpp
index 36fa933404e1..d0131296f3ed 100644
--- a/lib/Target/SPIRV/SPIRVUtils.cpp
+++ b/lib/Target/SPIRV/SPIRVUtils.cpp
@@ -406,6 +406,10 @@ getMemSemanticsForStorageClass(SPIRV::StorageClass::StorageClass SC) {
     return SPIRV::MemorySemantics::WorkgroupMemory;
   case SPIRV::StorageClass::CrossWorkgroup:
     return SPIRV::MemorySemantics::CrossWorkgroupMemory;
+  case SPIRV::StorageClass::Generic:
+    return SPIRV::MemorySemantics::MemorySemantics(
+        SPIRV::MemorySemantics::WorkgroupMemory |
+        SPIRV::MemorySemantics::CrossWorkgroupMemory);
   case SPIRV::StorageClass::AtomicCounter:
     return SPIRV::MemorySemantics::AtomicCounterMemory;
   case SPIRV::StorageClass::Image:
