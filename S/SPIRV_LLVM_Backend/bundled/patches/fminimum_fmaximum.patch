+; CHECK: %[[#Uno:]] = OpUnordered %[[#]] %[[#A]] %[[#B]]
+; CHECK: %[[#Res:]] = OpSelect %[[#BF16]] %[[#Uno]] %[[#NaN]] %[[#Signed]]
+; CHECK: OpReturnValue %[[#Res]]
