Look for KLU shared libraries on Windows, not only import libraries: https://github.com/LLNL/sundials/issues/29

diff --git a/cmake/tpl/FindKLU.cmake b/cmake/tpl/FindKLU.cmake
index 0b8981daf..1c486c35d 100644
--- a/cmake/tpl/FindKLU.cmake
+++ b/cmake/tpl/FindKLU.cmake
@@ -78,6 +78,10 @@ elseif(APPLE)
   set(CMAKE_FIND_LIBRARY_SUFFIXES d.a ${CMAKE_FIND_LIBRARY_SUFFIXES})
 endif()
 
+# Ensure on Windows we look for shared libraries `*.dll`, instead of just import
+# libraries (we don't have those for suitesparseconfig).
+set(CMAKE_FIND_LIBRARY_SUFFIXES ".$ENV{dlext}" ${CMAKE_FIND_LIBRARY_SUFFIXES})
+
 # Find include dir
 find_path(temp_KLU_INCLUDE_DIR klu.h ${KLU_INCLUDE_DIR})
 if(temp_KLU_INCLUDE_DIR)
