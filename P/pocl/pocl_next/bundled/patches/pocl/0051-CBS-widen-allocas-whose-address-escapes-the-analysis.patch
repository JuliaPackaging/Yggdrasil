From 79425ec8a7f3f92d534e4a6d12da6d6c93142614 Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Thu, 5 Nov 2026 21:19:52 +0100
Subject: [PATCH] CBS: widen allocas whose address escapes the analysis of
 their uses

isAllocaSubCfgInternal() keeps a private alloca shared by all work-items
when all of its uses are in one sub-CFG. fillUserHull() only followed
users that access memory or produce a pointer, so it lost the address
when it was stored, e.g. into the context array that carries a pointer
phi across a barrier, or to local memory. The loads after the barrier
went unseen, the alloca was not widened, and the work-items overwrote
each other's value.

Follow the address through stores into other allocas and the loads from
them, as AdaptiveCpp does since AdaptiveCpp/AdaptiveCpp#1763 (this pass
was taken from AdaptiveCpp). Unlike that fix, track which values carry
the address, so that a value loaded from the alloca doesn't widen it
when passed to a call or stored, and widen the alloca when the address
reaches a use that isn't followed: a store to other memory, a ptrtoint
(which the hull used to cover by including every direct user), or a
call that may read a stored copy. doesNotCapture() also handles LLVM
21's captures attribute.

Assisted-by: Opus 5.5 and Sol 6.1
---
 lib/llvmopencl/SubCFGFormation.cc             |  88 ++++++--
 tests/regression/CMakeLists.txt               |   3 +
 .../test_private_address_across_barrier.c     | 209 ++++++++++++++++++
 3 files changed, 286 insertions(+), 14 deletions(-)
 create mode 100644 tests/regression/test_private_address_across_barrier.c

diff --git a/lib/llvmopencl/SubCFGFormation.cc b/lib/llvmopencl/SubCFGFormation.cc
index e7bb9e80d..53b0dd3ab 100644
--- a/lib/llvmopencl/SubCFGFormation.cc
+++ b/lib/llvmopencl/SubCFGFormation.cc
@@ -1110,26 +1110,85 @@ void purgeLifetime(SubCFG &Cfg) {
     I->eraseFromParent();
 }
 
-// fills \a Hull with all transitive users of \a Alloca
-void fillUserHull(llvm::AllocaInst *Alloca,
+// looks through GEPs and bitcasts to find the alloca \a V points into
+static llvm::AllocaInst *getAllocaFromGEP(llvm::Value *V) {
+  if (auto *GEP = llvm::dyn_cast<llvm::GetElementPtrInst>(V))
+    return getAllocaFromGEP(GEP->getPointerOperand());
+  if (auto *BC = llvm::dyn_cast<llvm::BitCastInst>(V))
+    return getAllocaFromGEP(BC->getOperand(0));
+  return llvm::dyn_cast<llvm::AllocaInst>(V);
+}
+
+// fills \a Hull with all transitive users of \a Alloca outside the entry
+// block, following its address when it is stored into another alloca.
+// Returns true if the address escapes where its uses can't be followed, e.g.
+// into an integer, a call that may capture it, or memory that is not an
+// alloca.
+// Based on https://github.com/AdaptiveCpp/AdaptiveCpp/pull/1763.
+bool fillUserHull(llvm::AllocaInst *Alloca,
                   llvm::SmallVectorImpl<llvm::Instruction *> &Hull) {
+  // What a visited value carries: the address of Alloca, or the address of an
+  // alloca the former is stored in. Other values (e.g. loaded from Alloca)
+  // are only followed to their users.
+  enum : unsigned { Addr = 1, SlotAddr = 2 };
+  llvm::DenseMap<llvm::Instruction *, unsigned> Carries;
   llvm::SmallVector<llvm::Instruction *, 8> WL;
-  std::transform(Alloca->user_begin(), Alloca->user_end(),
-                 std::back_inserter(WL),
-                 [](auto *U) { return llvm::cast<llvm::Instruction>(U); });
-  llvm::SmallPtrSet<llvm::Instruction *, 32> AlreadySeen;
+  auto Visit = [&](llvm::Instruction *I, unsigned Kind) {
+    auto [It, New] = Carries.try_emplace(I, Kind);
+    if (New && !I->getParent()->isEntryBlock())
+      Hull.push_back(I);
+    if (New || (It->second | Kind) != It->second) {
+      It->second |= Kind;
+      WL.push_back(I);
+    }
+  };
+  Visit(Alloca, Addr);
   while (!WL.empty()) {
     auto *I = WL.pop_back_val();
-    AlreadySeen.insert(I);
-    Hull.push_back(I);
-    for (auto *U : I->users()) {
-      if (auto *UI = llvm::dyn_cast<llvm::Instruction>(U)) {
-        if (AlreadySeen.find(UI) == AlreadySeen.end())
-          if (UI->mayReadOrWriteMemory() || UI->getType()->isPointerTy())
-            WL.push_back(UI);
+    unsigned Kind = Carries[I];
+    for (auto &U : I->uses()) {
+      auto *UI = llvm::dyn_cast<llvm::Instruction>(U.getUser());
+      if (UI == nullptr)
+        continue;
+      if (Kind != 0) {
+        if (auto *SI = llvm::dyn_cast<llvm::StoreInst>(UI);
+            SI != nullptr && U.getOperandNo() == 0) {
+          // The address is stored, e.g. into the context array that carries
+          // a pointer phi across a barrier: the loads from that alloca, which
+          // may be in other sub-CFGs, yield the address again.
+          auto *StoredTo = getAllocaFromGEP(SI->getPointerOperand());
+          if (StoredTo == nullptr || (Kind & SlotAddr) != 0)
+            return true;
+          Visit(StoredTo, SlotAddr);
+        } else if (auto *CB = llvm::dyn_cast<llvm::CallBase>(UI)) {
+          // A call may read a stored address even if it doesn't capture the
+          // pointer to it.
+          if (Kind != Addr || !CB->isDataOperand(&U) ||
+              !CB->doesNotCapture(U.getOperandNo()))
+            return true;
+        } else {
+          // Other users may only access memory through the address, compare
+          // it or derive another pointer from it: e.g. ptrtoint, insertvalue
+          // or atomics on a stored address lose track of it.
+          bool IsAtomic =
+              llvm::isa<llvm::AtomicRMWInst, llvm::AtomicCmpXchgInst>(UI);
+          bool Followed =
+              llvm::isa<llvm::LoadInst, llvm::StoreInst, llvm::ICmpInst>(UI) ||
+              (IsAtomic && U.getOperandNo() == 0 && Kind == Addr) ||
+              (!IsAtomic && UI->getType()->isPtrOrPtrVectorTy());
+          if (!Followed)
+            return true;
+        }
       }
+      if (auto *LI = llvm::dyn_cast<llvm::LoadInst>(UI))
+        Visit(LI, (Kind & SlotAddr) != 0 ? Addr : 0);
+      else if (UI->getType()->isPtrOrPtrVectorTy())
+        Visit(UI, llvm::isa<llvm::CallBase>(UI) ? 0 : Kind);
+      else if (UI->mayReadOrWriteMemory())
+        Visit(UI, 0);
     }
   }
+  return false;
 }
 
 template <class PtrSet> struct PtrSetWrapper {
@@ -1151,7 +1210,8 @@ bool isAllocaSubCfgInternal(llvm::AllocaInst *Alloca,
   llvm::SmallPtrSet<llvm::BasicBlock *, 16> UserBlocks;
   {
     llvm::SmallVector<llvm::Instruction *, 32> Users;
-    fillUserHull(Alloca, Users);
+    if (fillUserHull(Alloca, Users))
+      return false;
     PtrSetWrapper<decltype(UserBlocks)> Wrapper{UserBlocks};
     std::transform(Users.begin(), Users.end(),
                    std::inserter(Wrapper, UserBlocks.end()),
diff --git a/tests/regression/CMakeLists.txt b/tests/regression/CMakeLists.txt
index 607fd8c20..ed882054b 100644
--- a/tests/regression/CMakeLists.txt
+++ b/tests/regression/CMakeLists.txt
@@ -40,6 +40,7 @@ set(C_PROGRAMS_TO_BUILD test_assign_loop_variable_to_privvar_makes_it_local
      test_uniform_implicit_barrier_entry
      test_localmem_load_across_barrier
      test_remat_alloca_store_address
+     test_private_address_across_barrier
      test_spirv_intel_subgroups
      test_spirv_bfloat16
      test_unrolled_barrier_loops
@@ -234,6 +235,8 @@ add_test_pocl(NAME "regression/unrolled_barrier_loops" WORKITEM_HANDLER "loops;l
 add_test_pocl(NAME "regression/unrolled_barrier_loops_dynamic" WORKITEM_HANDLER "loopvec" COMMAND "test_unrolled_barrier_loops")
 set_tests_properties("regression/unrolled_barrier_loops_dynamic" PROPERTIES ENVIRONMENT "POCL_WORK_GROUP_METHOD=loopvec;POCL_WORK_GROUP_SPECIALIZATION=0")
 
+add_test_pocl(NAME "regression/private_address_across_barrier" WORKITEM_HANDLER "loops;loopvec;cbs;" COMMAND "test_private_address_across_barrier")
+
 add_test_pocl(NAME "regression/test_usm_indirect_ptrs" COMMAND "test_usm_indirect_ptrs")
 
 add_test_pocl(NAME "regression/test_usm_free_realloc" COMMAND "test_usm_free_realloc" WORKITEM_HANDLER "loopvec")
diff --git a/tests/regression/test_private_address_across_barrier.c b/tests/regression/test_private_address_across_barrier.c
new file mode 100644
index 000000000..62884ba2b
--- /dev/null
+++ b/tests/regression/test_private_address_across_barrier.c
@@ -0,0 +1,209 @@
