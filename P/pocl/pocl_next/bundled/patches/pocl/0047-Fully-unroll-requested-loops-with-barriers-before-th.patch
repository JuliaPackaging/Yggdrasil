diff --git a/tests/compiler_unit/unroll-barrier-loop-no-request.cl b/tests/compiler_unit/unroll-barrier-loop-no-request.cl
new file mode 100644
index 000000000..a547506e5
--- /dev/null
+++ b/tests/compiler_unit/unroll-barrier-loop-no-request.cl
@@ -0,0 +1,12 @@
+// A sub-group butterfly over a sub-group size that is known at compile time
+// stays a b-loop without an unroll request, which LoopBarriers marks with a
+// barrier in the preheader.
+#pragma OPENCL EXTENSION cl_khr_subgroups : enable
+__attribute__((intel_reqd_sub_group_size(8)))
+kernel void sub_group_sum(global int *out, global const int *in) {
+  size_t i = get_global_id(0);
+  int v = in[i];
+  for (uint m = 1; m < get_max_sub_group_size(); m <<= 1)
+    v += sub_group_shuffle_xor(v, m);
+  out[i] = v;
+}
