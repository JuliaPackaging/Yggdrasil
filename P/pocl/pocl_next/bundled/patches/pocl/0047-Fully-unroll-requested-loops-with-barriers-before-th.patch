diff --git a/lib/llvmopencl/UnrollBarrierLoops.cc b/lib/llvmopencl/UnrollBarrierLoops.cc
new file mode 100644
index 000000000..55c390668
--- /dev/null
+++ b/lib/llvmopencl/UnrollBarrierLoops.cc
@@ -0,0 +1,187 @@
+// UnrollBarrierLoops fully unrolls loops with barriers on request.
+//
+// Copyright (c) 2026 PoCL developers
+//
+// Permission is hereby granted, free of charge, to any person obtaining a copy
+// of this software and associated documentation files (the "Software"), to
