From a987cabf35aac406f6d653fa116b2bace2d9cabb Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Tue, 27 Oct 2026 01:00:16 +0100
Subject: [PATCH 44/45] Skip host kernel coordinate divisions for ranges
 starting in the first row

clRunHostKernelPOCL used two 64-bit divisions to compute the range's first
work-group coordinates. Each takes tens of cycles on Intel CPUs before
Ice Lake. Ranges starting in the grid's first row, as launches on one thread
do, now need neither division. A trivial KernelAbstractions launch on a
Xeon E3-1245 v6 takes 518 instead of 566 cycles in a local build.
---
 lib/CL/devices/common_utils.c | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/lib/CL/devices/common_utils.c b/lib/CL/devices/common_utils.c
index 5e745523e..8a7ff95e2 100644
--- a/lib/CL/devices/common_utils.c
+++ b/lib/CL/devices/common_utils.c
@@ -386,10 +386,21 @@ pocl_cpu_run_host_kernel (cl_host_kernel_pocl hk,
   enter_kernel_fp_mode (hk->fp_mode, &caller_fp_env);
 
   pocl_workgroup_func wg = (pocl_workgroup_func)hk->wg;
-  size_t x = first_group % pc.num_groups[0];
-  size_t yz = first_group / pc.num_groups[0];
-  size_t y = yz % pc.num_groups[1];
-  size_t z = yz / pc.num_groups[1];
+  /* Without dividing when the range starts in the first row or plane, as
+     small launches do: a 64-bit division takes up to ~90 cycles, against a
+     few hundred for a whole launch of a trivial kernel. */
+  size_t x = first_group, y = 0, z = 0;
+  if (x >= pc.num_groups[0])
+    {
+      size_t yz = x / pc.num_groups[0];
+      x -= yz * pc.num_groups[0];
+      y = yz;
+      if (yz >= pc.num_groups[1])
+        {
+          z = yz / pc.num_groups[1];
+          y = yz - z * pc.num_groups[1];
+        }
+    }
   for (size_t i = 0; i < group_count; ++i)
     {
       wg ((uint8_t *)args, (uint8_t *)&pc, x, y, z);
-- 
