From 394099bbae75f3e5abda54c8563f221d3057cc1e Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Tue, 3 Nov 2026 14:26:58 +0100
Subject: [PATCH] Accept SPV_KHR_bfloat16 SPIR-V on the CPU devices

SPV_KHR_bfloat16 adds a bfloat16 floating-point type to SPIR-V for loads,
stores and conversions to and from other floating-point types. LLVM's
SPIR-V back-end needs it for any LLVM IR that uses `bfloat`, e.g. from
Julia's BFloat16, and the translator maps it back to `bfloat`.

The SPIR-V reader rejects modules using extensions that are not enabled
with --spirv-ext, so such modules failed to build. Enable the extension
for the CPU devices when the translator reads it: libLLVMSPIRV is checked
for it, since the 18-20 release branches only gained it in later point
releases, and the llvm-spirv binary is assumed to read it from LLVM 21
on. Report it and the BFloat16TypeKHR capability, added to the vendored
spirv.hh with the extension's other capabilities, through
CL_DEVICE_SPIRV_EXTENSIONS_KHR and CL_DEVICE_SPIRV_CAPABILITIES_KHR.
---
 CMakeLists.txt                         |   5 +
 cmake/SetupLLVMSPIRV.cmake             |  21 ++
 lib/CL/devices/spirv.hh                |   3 +
 lib/CL/devices/spirv_queries.cc        |   7 +
 tests/regression/CMakeLists.txt        |   7 +
 tests/regression/test_spirv_bfloat16.c | 294 +++++++++++++++++++++++++
 6 files changed, 337 insertions(+)
 create mode 100644 tests/regression/test_spirv_bfloat16.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7dcff7b5c..3f95d9bdf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1926,6 +1926,11 @@ endif()
 if(HOST_DEVICE_EXTENSIONS MATCHES "cl_khr_extended_bit_ops")
   set(HOST_DEVICE_SPV_EXTENSIONS "${HOST_DEVICE_SPV_EXTENSIONS},+SPV_KHR_bit_instructions")
 endif()
+# SPV_KHR_bfloat16: a bfloat16 type for loads, stores and conversions to and
+# from other floating-point types. The translator maps it to LLVM's bfloat.
+if(HAVE_LLVM_SPIRV_KHR_BFLOAT16)
+  set(HOST_DEVICE_SPV_EXTENSIONS "${HOST_DEVICE_SPV_EXTENSIONS},+SPV_KHR_bfloat16")
+endif()
 # The SPIR-V side of cl_intel_subgroups: shuffles (also of vectors) and buffer block
 # reads/writes. cl_intel_spirv_subgroups is not advertised, as it also requires the
 # image block reads/writes.
diff --git a/cmake/SetupLLVMSPIRV.cmake b/cmake/SetupLLVMSPIRV.cmake
index ea0e770ce..6423a75d2 100644
--- a/cmake/SetupLLVMSPIRV.cmake
+++ b/cmake/SetupLLVMSPIRV.cmake
@@ -94,6 +94,18 @@ if(HAVE_LLVM_SPIRV_LIB)
       set(LLVM_SPIRV_LIB_HAS_ERROR_HANDLING 0 CACHE BOOL "libLLVMSPIRV has TranslatorOpts::setErrorHandlingKind")
     endif()
   endif()
+
+  # The translator reads SPV_KHR_bfloat16 since LLVM 21, and since 18.1.14,
+  # 19.1.8 and 20.1.3 on the older release branches. Not cached, so that it
+  # follows changes of the translator.
+  file(READ "${LLVM_SPIRV_INCLUDEDIR}/LLVMSPIRVExtensions.inc" LLVMSPIRVEXTENSIONS_CONTENT)
+  if(LLVMSPIRVEXTENSIONS_CONTENT MATCHES "EXT\\(SPV_KHR_bfloat16\\)")
+    message(STATUS "libLLVMSPIRV supports SPV_KHR_bfloat16")
+    set(LLVM_SPIRV_LIB_HAS_KHR_BFLOAT16 1)
+  else()
+    message(STATUS "libLLVMSPIRV is too old for SPV_KHR_bfloat16")
+    set(LLVM_SPIRV_LIB_HAS_KHR_BFLOAT16 0)
+  endif()
 else()
   message(STATUS "LLVMSPIRV library NOT found: ${LLVM_SPIRV_INCLUDEDIR} | ${LLVM_SPIRV_LIB}")
 endif()
@@ -105,6 +117,15 @@ set_expr(HAVE_SPIRV_LINK TARGET_SPIRV_LINK)
 set_expr(HAVE_LLVM_SPIRV TARGET_LLVM_SPIRV)
 set_expr(HAVE_LLVM_OPT TARGET_LLVM_OPT)
 
+# Without the library, the llvm-spirv binary is used, whose extensions can't be
+# queried; every translator release for LLVM 21 and later reads SPV_KHR_bfloat16.
+if(HAVE_LLVM_SPIRV_LIB)
+  set_expr(HAVE_LLVM_SPIRV_KHR_BFLOAT16 LLVM_SPIRV_LIB_HAS_KHR_BFLOAT16)
+else()
+  set_expr(HAVE_LLVM_SPIRV_KHR_BFLOAT16
+    HAVE_LLVM_SPIRV AND (LLVM_VERSION_MAJOR GREATER_EQUAL 21))
+endif()
+
 if(HAVE_SPIRV_LINK AND (NOT DEFINED SPIRV_LINK_HAS_USE_HIGHEST_VERSION)
   AND NOT CMAKE_CROSSCOMPILING)
   # TODO crosscompiling
diff --git a/lib/CL/devices/spirv.hh b/lib/CL/devices/spirv.hh
index 000d71159..fe0076ba5 100644
--- a/lib/CL/devices/spirv.hh
+++ b/lib/CL/devices/spirv.hh
@@ -713,6 +713,9 @@ enum class Capability : unsigned {
   ShaderClockKHR = 5055,
   ShaderEnqueueAMDX = 5067,
   QuadControlKHR = 5087,
+  BFloat16TypeKHR = 5116,
+  BFloat16DotProductKHR = 5117,
+  BFloat16CooperativeMatrixKHR = 5118,
   SampleMaskOverrideCoverageNV = 5249,
   GeometryShaderPassthroughNV = 5251,
   ShaderViewportIndexLayerEXT = 5254,
diff --git a/lib/CL/devices/spirv_queries.cc b/lib/CL/devices/spirv_queries.cc
index 904fc69af..8765f0dc7 100644
--- a/lib/CL/devices/spirv_queries.cc
+++ b/lib/CL/devices/spirv_queries.cc
@@ -247,6 +247,13 @@ void pocl_setup_spirv_queries(cl_device_id dev) {
     }
   }
 
+  if (dev->supported_spirv_extensions &&
+      strstr(dev->supported_spirv_extensions, "SPV_KHR_bfloat16")) {
