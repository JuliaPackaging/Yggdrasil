   std::vector<Use *> Uses = findInstructionUses(GVar);
   // we must recursively search for each function called by F, because
diff --git a/lib/llvmopencl/LLVMUtils.h b/lib/llvmopencl/LLVMUtils.h
index fc79408d8..130784c6f 100644
--- a/lib/llvmopencl/LLVMUtils.h
+++ b/lib/llvmopencl/LLVMUtils.h
@@ -128,6 +128,10 @@ bool isCompilerExpandableWIFunctionCall(const llvm::CallInst &Call);
 POCL_EXPORT
