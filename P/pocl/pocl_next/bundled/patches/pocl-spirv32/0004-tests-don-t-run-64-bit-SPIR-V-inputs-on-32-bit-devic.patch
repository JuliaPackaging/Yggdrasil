 tests/regression/test_spirv_intel_subgroups.c          |  4 ++++
 tests/regression/test_unreachable_kernel.c             |  4 ++++
 tests/spirv/printf-kernels.cl                          |  3 +++
 tests/spirv/printf.cc                                  | 10 +++++++++-
 13 files changed, 58 insertions(+), 2 deletions(-)

diff --git a/tests/compiler_unit/CMakeLists.txt b/tests/compiler_unit/CMakeLists.txt
index 418067ea9..5f6d18ed3 100644
--- a/tests/compiler_unit/CMakeLists.txt
+++ b/tests/compiler_unit/CMakeLists.txt
@@ -42,7 +42,8 @@ function(add_llvm_check)
     set(WORKITEM_HANDLER "loopvec")
   endif()
   if (POCL_UTEST_SPIRV_NAME)
-    if (ENABLE_SPIRV)
+    # the .spirv inputs are 64-bit
+    if (ENABLE_SPIRV AND HOST_DEVICE_ADDRESS_BITS EQUAL 64)
       add_test_pocl(NAME "kernel_compiler_unit_tests/${POCL_UTEST_SPIRV_NAME}"
         COMMAND "poclcc" -s -o ${POCL_UTEST_SPIRV_NAME}.out
         "${CMAKE_CURRENT_SOURCE_DIR}/${POCL_UTEST_SPIRV_NAME}.spirv"
diff --git a/tests/regression/test_barrier_divergent_skip.c b/tests/regression/test_barrier_divergent_skip.c
index 69b1b29fd..43f80b006 100644
