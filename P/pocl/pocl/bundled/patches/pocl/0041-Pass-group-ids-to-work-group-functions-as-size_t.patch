From b60515418320798bf9f415c9d74c32cbcb1d919d Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Tue, 20 Oct 2026 16:07:52 +0200
Subject: [PATCH] Pass group ids to work-group functions as size_t

Workgroup.cc generates work-group functions that take size_t group ids, but
the drivers call them through a prototype that declares them as ulong. On the
host, ulong is unsigned long, which is 32 bits on 64-bit Windows. There, a
caller sets only the low half of group_z (passed on the stack), so the kernel
sees garbage unless that stack slot happens to be zero, and group ids of 2^32
or more are truncated.
---
 include/pocl_workgroup_func.h | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/include/pocl_workgroup_func.h b/include/pocl_workgroup_func.h
index d63747ba6..bf9f13069 100644
--- a/include/pocl_workgroup_func.h
+++ b/include/pocl_workgroup_func.h
@@ -28,12 +28,13 @@
 
 #include "pocl_types.h"
 
-/* The default work-group function prototype as generated by Workgroup.cc. */
+/* The default work-group function prototype as generated by Workgroup.cc.
+   The group ids are size_t: the host's ulong is 32 bits on 64-bit Windows. */
 typedef void (*pocl_workgroup_func) (uchar * /* args */,
 				     uchar * /* pocl_context */,
-				     ulong /* group_x */,
-				     ulong /* group_y */,
-				     ulong /* group_z */);
+				     size_t /* group_x */,
+				     size_t /* group_y */,
+				     size_t /* group_z */);
 
 /* Version for 32b targets with 32b max dimension sizes. */
 typedef void (*pocl_workgroup_func32) (uchar * /* args */,
-- 
