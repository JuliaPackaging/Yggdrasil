From fefdded32044e9e693b6f4e1ac61887e326deed6 Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Tue, 3 Nov 2026 14:56:43 +0100
Subject: [PATCH] Fix abs() of the minimum signed integer

abs() returns ugentype, so abs(INT_MIN) is (uint)2147483648. The int
overload used __builtin_abs, which is undefined for INT_MIN and becomes
llvm.abs with int_min_is_poison set, and the long overload negated the
signed value with an nsw sub. LLVM then assumed that the result's top
bit is clear, e.g. folding abs(x) >> 31 to 0 or converting abs(x) to
float as a signed value. Vector overloads were split down to these
scalar ones, and abs_diff() of operands with different signs uses
abs().

Use __builtin_elementwise_abs for the signed types instead. It emits
llvm.abs without the poison flag, also for vectors. It rejects unsigned
arguments, so split DEFINE_EXPR_UG_G into signed and unsigned halves;
abs() of an unsigned value is the value itself.

Register the existing kernel/test_abs and kernel/test_abs_diff, which
were never run, and check the top bit of abs() of the minimum value.
---
 lib/kernel/abs.cl           | 14 ++++++-------
 lib/kernel/templates.h      | 40 +++++++++++++++++++------------------
 tests/kernel/CMakeLists.txt |  7 +++++++
 tests/kernel/test_abs.cl    | 26 ++++++++++++++++++++++++
 4 files changed, 60 insertions(+), 27 deletions(-)

diff --git a/lib/kernel/abs.cl b/lib/kernel/abs.cl
index 22b6e4ff4..e9ec4a79d 100644
--- a/lib/kernel/abs.cl
+++ b/lib/kernel/abs.cl
@@ -24,12 +24,10 @@
 
 #include "templates.h"
 
-#define __builtin_abshh(a)   ((uchar )(a>=(char )0 ? a : (char )-a))
-#define __builtin_absh(a)    ((ushort)(a>=(short)0 ? a : (short)-a))
-#define __builtin_absl(a)    ((ulong )(a>=(long )0 ? a : (long )-a))
-#define __builtin_absuhh(a)  a
-#define __builtin_absuh(a)   a
-#define __builtin_absu(a)    a
-#define __builtin_absul(a)   a
+/* Unlike __builtin_abs, the elementwise builtin returns the signed minimum
+   unchanged. Reinterpreting it as unsigned gives the required magnitude.
+   The gtype cast handles clang 18's promotion of scalar char and short. */
+DEFINE_EXPR_UG_G_SIGNED (
+    abs, __builtin_astype ((gtype)__builtin_elementwise_abs (a), ugtype))
 
-DEFINE_BUILTIN_UG_G(abs)
+DEFINE_EXPR_UG_G_UNSIGNED (abs, a)
diff --git a/lib/kernel/templates.h b/lib/kernel/templates.h
index 6ae3f794f..58bbbab8c 100644
--- a/lib/kernel/templates.h
+++ b/lib/kernel/templates.h
@@ -1471,37 +1471,45 @@
     typedef SUGTYPE sugtype;                                            \
     return EXPR;                                                        \
   }
-#define DEFINE_EXPR_UG_G(NAME, EXPR)                                    \
+#define DEFINE_EXPR_UG_G_SIGNED(NAME, EXPR)                             \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, char    , char  , uchar   , uchar )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, char2   , char  , uchar2  , uchar )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, char3   , char  , uchar3  , uchar )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, char4   , char  , uchar4  , uchar )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, char8   , char  , uchar8  , uchar )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, char16  , char  , uchar16 , uchar )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar   , uchar , uchar   , uchar )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar2  , uchar , uchar2  , uchar )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar3  , uchar , uchar3  , uchar )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar4  , uchar , uchar4  , uchar )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar8  , uchar , uchar8  , uchar )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar16 , uchar , uchar16 , uchar )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, short   , short , ushort  , ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, short2  , short , ushort2 , ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, short3  , short , ushort3 , ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, short4  , short , ushort4 , ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, short8  , short , ushort8 , ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, short16 , short , ushort16, ushort)   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort  , ushort, ushort  , ushort)   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort2 , ushort, ushort2 , ushort)   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort3 , ushort, ushort3 , ushort)   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort4 , ushort, ushort4 , ushort)   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort8 , ushort, ushort8 , ushort)   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort16, ushort, ushort16, ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, int     , int   , uint    , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, int2    , int   , uint2   , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, int3    , int   , uint3   , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, int4    , int   , uint4   , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, int8    , int   , uint8   , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, int16   , int   , uint16  , uint  )   \
+  __IF_INT64(                                                           \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long    , long  , ulong   , ulong )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long2   , long  , ulong2  , ulong )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long3   , long  , ulong3  , ulong )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long4   , long  , ulong4  , ulong )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long8   , long  , ulong8  , ulong )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long16  , long  , ulong16 , ulong ))
+#define DEFINE_EXPR_UG_G_UNSIGNED(NAME, EXPR)                           \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar   , uchar , uchar   , uchar )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar2  , uchar , uchar2  , uchar )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar3  , uchar , uchar3  , uchar )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar4  , uchar , uchar4  , uchar )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar8  , uchar , uchar8  , uchar )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, uchar16 , uchar , uchar16 , uchar )   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort  , ushort, ushort  , ushort)   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort2 , ushort, ushort2 , ushort)   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort3 , ushort, ushort3 , ushort)   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort4 , ushort, ushort4 , ushort)   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort8 , ushort, ushort8 , ushort)   \
+  IMPLEMENT_EXPR_UG_G(NAME, EXPR, ushort16, ushort, ushort16, ushort)   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, uint    , uint  , uint    , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, uint2   , uint  , uint2   , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, uint3   , uint  , uint3   , uint  )   \
@@ -1509,12 +1517,6 @@
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, uint8   , uint  , uint8   , uint  )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, uint16  , uint  , uint16  , uint  )   \
   __IF_INT64(                                                           \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long    , long  , ulong   , ulong )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long2   , long  , ulong2  , ulong )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long3   , long  , ulong3  , ulong )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long4   , long  , ulong4  , ulong )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long8   , long  , ulong8  , ulong )   \
-  IMPLEMENT_EXPR_UG_G(NAME, EXPR, long16  , long  , ulong16 , ulong )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, ulong   , ulong , ulong   , ulong )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, ulong2  , ulong , ulong2  , ulong )   \
   IMPLEMENT_EXPR_UG_G(NAME, EXPR, ulong3  , ulong , ulong3  , ulong )   \
diff --git a/tests/kernel/CMakeLists.txt b/tests/kernel/CMakeLists.txt
index 481203c77..e52338b39 100644
--- a/tests/kernel/CMakeLists.txt
+++ b/tests/kernel/CMakeLists.txt
@@ -52,6 +52,12 @@ add_test_pocl(NAME "kernel/test_convert_type_8"
 add_test_pocl(NAME "kernel/test_convert_type_16"
               COMMAND "kernel" "test_convert_type_16")
 
+add_test_pocl(NAME "kernel/test_abs"
+              COMMAND "kernel" "test_abs")
+
+add_test_pocl(NAME "kernel/test_abs_diff"
+              COMMAND "kernel" "test_abs_diff")
+
 add_test_pocl(NAME "kernel/test_bitselect"
               COMMAND "kernel" "test_bitselect")
 
@@ -125,6 +131,7 @@ foreach(VARIANT ${VARIANTS})
     "kernel/test_convert_type_1_${VARIANT}" "kernel/test_convert_type_2_${VARIANT}" "kernel/test_convert_type_4_${VARIANT}"
     "kernel/test_convert_type_8_${VARIANT}" "kernel/test_convert_type_16_${VARIANT}"
     "kernel/test_hadd_${VARIANT}" "kernel/test_rotate_${VARIANT}"
+    "kernel/test_abs_${VARIANT}" "kernel/test_abs_diff_${VARIANT}"
     PROPERTIES
       COST 40.0
       PROCESSORS 1
diff --git a/tests/kernel/test_abs.cl b/tests/kernel/test_abs.cl
index f41007f20..78c648e5b 100644
--- a/tests/kernel/test_abs.cl
+++ b/tests/kernel/test_abs.cl
@@ -19,6 +19,32 @@ DEFINE_BODY_G_HADD (test_abs, ({
                             }
                           error = true;
                         }
+                      // abs of the minimum value is 2^(bits-1), so the top
+                      // bit of the result is set. Computing it as a signed
+                      // negation overflows, after which LLVM may assume that
+                      // the bit is clear.
+                      Tvec m, res_top;
+                      for (int n = 0; n < vecsize; ++n)
+                        {
+                          m.s[n] = x.s[n] & tmin;
+                        }
+                      res_top.u = abs (m.v) >> (sugtype)(bits - 1);
+                      equal = true;
+                      for (int n = 0; n < vecsize; ++n)
+                        {
+                          equal = equal && res_top.s[n] == (m.s[n] != 0);
+                        }
+                      if (!equal)
+                        {
+                          printf ("FAIL: abs top bit type=%s\n", typename);
+                          for (int n = 0; n < vecsize; ++n)
+                            {
+                              printf ("   [%d] a=%s good=%d res=%d\n", n,
+                                      m.s[n] != 0 ? "min" : "0",
+                                      (int)(m.s[n] != 0), (int)res_top.s[n]);
+                            }
+                          error = true;
+                        }
                     }))
 
 kernel void
