From b3064ee91c289769aae5821094ee72af01087526 Mon Sep 17 00:00:00 2001
From: Valentin Churavy <v.churavy@gmail.com>
Date: Sun, 4 Oct 2026 17:45:28 +0200
Subject: [PATCH] Include the kernel compiler sources in the kernel cache key

The kernel cache key is seeded with the PoCL version, the build timestamp,
the LLVM version and a hash of the kernel library, but not with anything
that identifies the kernel compiler (the PoCL LLVM passes and the
work-group function generation). Builds of the same PoCL version that differ
only in kernel compiler patches therefore share cache entries. With
SOURCE_DATE_EPOCH set, as in reproducible distribution builds, the build
timestamp is constant too, so e.g. a build with a work-item loops fix
silently reuses binaries miscompiled by the previous build of the same
version from the default cache directory.

Hash the kernel compiler sources (lib/llvmopencl and lib/CL/pocl_llvm_*)
into POCL_KERNELLIB_SHA1 alongside the kernel library.

Assisted-by: Claude Code (Opus 5.5)
---
 cmake/kernellib_hash.cmake | 14 +++++++++++++-
 lib/kernel/CMakeLists.txt  | 19 ++++++++++++++++++-
 2 files changed, 31 insertions(+), 2 deletions(-)

diff --git a/cmake/kernellib_hash.cmake b/cmake/kernellib_hash.cmake
index 70e75b523..2356ede7f 100644
--- a/cmake/kernellib_hash.cmake
+++ b/cmake/kernellib_hash.cmake
@@ -26,6 +26,18 @@ file(SHA1 "${INCLUDEDIR}/_kernel.h" S2)
 file(SHA1 "${INCLUDEDIR}/_kernel_c.h" S3)
 file(SHA1 "${INCLUDEDIR}/pocl_types.h" S4)
 
-file(WRITE "${OUTPUT}.new" "#define POCL_KERNELLIB_SHA1 \"${S1}${S2}_${S3}_${S4}\"")
+# The kernel compiler sources, folded into a single hash.
+string(REPLACE "****" ";" KERNEL_COMPILER_SOURCES
+       "${KERNEL_COMPILER_SOURCES_ESCAPED}")
+set(COMPILER_HASHES "")
+foreach(SRC IN LISTS KERNEL_COMPILER_SOURCES)
+  if(EXISTS ${SRC})
+    file(SHA1 "${SRC}" S)
+    string(APPEND COMPILER_HASHES "${S}")
+  endif()
+endforeach()
+string(SHA1 S5 "${COMPILER_HASHES}")
+
+file(WRITE "${OUTPUT}.new" "#define POCL_KERNELLIB_SHA1 \"${S1}${S2}_${S3}_${S4}_${S5}\"")
 
 rename_if_different("${OUTPUT}.new" "${OUTPUT}")
diff --git a/lib/kernel/CMakeLists.txt b/lib/kernel/CMakeLists.txt
index b98dbdecc..ebca19f04 100644
--- a/lib/kernel/CMakeLists.txt
+++ b/lib/kernel/CMakeLists.txt
@@ -228,16 +228,33 @@ endif()
 
 #*********************************************************************
 
+# The kernel compiler (the PoCL LLVM passes and the work-group function
+# generation) shapes the cached kernel binaries as much as the kernel library
+# does, so hash its sources too. Otherwise two builds of the same PoCL version
+# that differ only in kernel compiler patches (and, with SOURCE_DATE_EPOCH set,
+# share the same POCL_BUILD_TIMESTAMP) reuse each other's cached binaries.
+file(GLOB KERNEL_COMPILER_SOURCES CONFIGURE_DEPENDS
+  "${CMAKE_SOURCE_DIR}/lib/llvmopencl/*.cc"
+  "${CMAKE_SOURCE_DIR}/lib/llvmopencl/*.cpp"
+  "${CMAKE_SOURCE_DIR}/lib/llvmopencl/*.h"
+  "${CMAKE_SOURCE_DIR}/lib/llvmopencl/*.hh"
+  "${CMAKE_SOURCE_DIR}/lib/CL/pocl_llvm_*.cc"
+  "${CMAKE_SOURCE_DIR}/lib/CL/pocl_llvm_*.h")
+list(SORT KERNEL_COMPILER_SOURCES)
+
 # "Escape" a list before passing to an external command
 string(REPLACE ";" "****" KERNEL_BC_LIST_ESCAPED "${KERNEL_BC_LIST}")
+string(REPLACE ";" "****" KERNEL_COMPILER_SOURCES_ESCAPED
+       "${KERNEL_COMPILER_SOURCES}")
 
 add_custom_command( OUTPUT "${CMAKE_BINARY_DIR}/kernellib_hash.h"
   COMMAND "${CMAKE_COMMAND}"
       -DKERNEL_BC_LIST_ESCAPED='${KERNEL_BC_LIST_ESCAPED}'
+      -DKERNEL_COMPILER_SOURCES_ESCAPED='${KERNEL_COMPILER_SOURCES_ESCAPED}'
       -DINCLUDEDIR='${CMAKE_SOURCE_DIR}/include'
       -DOUTPUT='${CMAKE_BINARY_DIR}/kernellib_hash.h'
       -P "${CMAKE_SOURCE_DIR}/cmake/kernellib_hash.cmake"
-  DEPENDS ${KERNEL_BC_LIST}
+  DEPENDS ${KERNEL_BC_LIST} ${KERNEL_COMPILER_SOURCES}
       "${CMAKE_SOURCE_DIR}/include/_kernel.h"
       "${CMAKE_SOURCE_DIR}/include/_kernel_c.h"
       "${CMAKE_SOURCE_DIR}/include/pocl_types.h"
-- 
