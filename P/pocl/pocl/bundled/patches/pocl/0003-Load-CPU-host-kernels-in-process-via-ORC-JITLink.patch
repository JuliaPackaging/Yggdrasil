+                 "object failed:\n%s\n",
+                 Log.c_str());
+    return -1;
+  }
+
+  auto PreserveEntryPoints = [&EntryPoints](const llvm::GlobalValue &GV) {
+    return EntryPoints.contains(GV.getName());
+  };
+  internalizeModule(*ParallelBC, PreserveEntryPoints);
+  populateModulePM(nullptr, ParallelBC, /*OptL=*/3);
+  return 0;
+}
