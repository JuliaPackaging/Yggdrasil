+{
+  POCL_OBJECT;
+  /* The root device, which the program is built for. */
+  cl_device_id device;
+  /* Retained, so that the program can't be rebuilt. */
+  cl_kernel kernel;
+  cl_program program;
+  cl_uint program_device_i;
+  cl_uint work_dim;
