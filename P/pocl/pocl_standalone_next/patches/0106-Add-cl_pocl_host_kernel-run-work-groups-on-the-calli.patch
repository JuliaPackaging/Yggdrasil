+    "  size_t l = get_local_id (0);\n"
+    "  scratch[l] = in[get_global_id (0)];\n"
+    "  if (l == 0)\n"
+    "    total = 0;\n"
+    "  barrier (CLK_LOCAL_MEM_FENCE);\n"
+    "  if (l == 0)\n"
