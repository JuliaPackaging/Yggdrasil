diff --git a/lib/CL/clHostKernelPOCL.c b/lib/CL/clHostKernelPOCL.c
new file mode 100644
index 000000000..1279ac673
--- /dev/null
+++ b/lib/CL/clHostKernelPOCL.c
@@ -0,0 +1,319 @@
+/* OpenCL runtime library: cl_pocl_host_kernel
+
+   Copyright (c) 2026 PoCL developers
+
