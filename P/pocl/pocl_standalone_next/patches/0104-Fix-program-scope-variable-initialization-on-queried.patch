From aaa452b2505458fcbf4de53b43398f32031682fb Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Mon, 19 Oct 2026 17:00:12 +0200
Subject: [PATCH] Fix program-scope variable initialization on queried and
 rebuilt programs

pocl_driver_build_poclbinary compiles the hidden gvar initialization kernel
through pocl_driver_build_gvar_init_kernel without a callback, which also
allocated the storage. The first launch then found the storage allocated and
never ran the initializer, so querying CL_PROGRAM_BINARIES before running a
kernel left all program-scope variables uninitialized. Only allocate the
storage when the initializer actually runs, and do so under the program lock,
publishing the storage after initialization, so that launches racing on
different threads or queues can't see a half-initialized (or doubly
allocated) buffer either.

The CPU drivers' free_program also freed the storage without clearing the
pointer, so after clBuildProgram on an already built program the initializer
was skipped and kernels used freed memory.
---
 lib/CL/devices/basic/basic.c                 |   1 +
 lib/CL/devices/common_driver.c               | 144 +++++++++++--------
 tests/regression/test_program_scope_vars.cpp |  76 ++++++++++
 3 files changed, 165 insertions(+), 56 deletions(-)

diff --git a/lib/CL/devices/basic/basic.c b/lib/CL/devices/basic/basic.c
index bece25d9e..2fd258c62 100644
--- a/lib/CL/devices/basic/basic.c
+++ b/lib/CL/devices/basic/basic.c
@@ -635,6 +635,7 @@ pocl_basic_free_program (cl_device_id device, cl_program program,
   pocl_driver_free_program (device, program, dev_i);
   program->global_var_total_size[dev_i] = 0;
   pocl_aligned_free (program->gvar_storage[dev_i]);
+  program->gvar_storage[dev_i] = NULL;
   return 0;
 }
 /*********************** IMAGES ********************************/
diff --git a/lib/CL/devices/common_driver.c b/lib/CL/devices/common_driver.c
index 0a3e605d9..1b1f7880b 100644
--- a/lib/CL/devices/common_driver.c
+++ b/lib/CL/devices/common_driver.c
@@ -1190,6 +1190,65 @@ pocl_driver_build_opencl_builtins (cl_program program, cl_uint device_i)
 #endif
 }
 
+#ifdef ENABLE_HOST_CPU_DEVICES
+/* Compiles the hidden initialization kernel and, with a callback, runs it on
+   STORAGE. */
+static int
+compile_gvar_init_kernel (cl_program program,
+                          cl_uint dev_i,
+                          cl_device_id device,
+                          void *storage,
+                          gvar_init_callback_t callback)
+{
+  pocl_kernel_metadata_t fake_meta;
+  memset (&fake_meta, 0, sizeof (fake_meta));
+  pocl_kernel_hash_t fake_build_hash;
+
+  SHA1_CTX hash_ctx;
+  pocl_SHA1_Init (&hash_ctx);
+  pocl_SHA1_Update (&hash_ctx, (uint8_t *)program->build_hash[dev_i],
+                    sizeof (SHA1_digest_t));
+  pocl_SHA1_Update (&hash_ctx, (uint8_t *)POCL_GVAR_INIT_KERNEL_NAME,
+                    strlen (POCL_GVAR_INIT_KERNEL_NAME));
+  pocl_SHA1_Final (&hash_ctx, fake_build_hash);
+
+  fake_meta.build_hash = &fake_build_hash;
+
+  struct _cl_kernel fake_kernel;
+  memset (&fake_kernel, 0, sizeof (fake_kernel));
+  fake_kernel.meta = &fake_meta;
+  fake_kernel.name = POCL_GVAR_INIT_KERNEL_NAME;
+  fake_kernel.context = program->context;
+  fake_kernel.program = program;
+
+  _cl_command_node fake_cmd;
+  memset (&fake_cmd, 0, sizeof (_cl_command_node));
+  fake_cmd.program_device_i = dev_i;
+  fake_cmd.device = device;
+  fake_cmd.type = CL_COMMAND_NDRANGE_KERNEL;
+  fake_cmd.command.run.kernel = &fake_kernel;
+  fake_cmd.command.run.hash = fake_meta.build_hash;
+  fake_cmd.command.run.pc.local_size[0] = 1;
+  fake_cmd.command.run.pc.local_size[1] = 1;
+  fake_cmd.command.run.pc.local_size[2] = 1;
+  fake_cmd.command.run.pc.work_dim = 3;
+  fake_cmd.command.run.pc.num_groups[0] = 1;
+  fake_cmd.command.run.pc.num_groups[1] = 1;
+  fake_cmd.command.run.pc.num_groups[2] = 1;
+  fake_cmd.command.run.pc.global_offset[0] = 0;
+  fake_cmd.command.run.pc.global_offset[1] = 0;
+  fake_cmd.command.run.pc.global_offset[2] = 0;
+  fake_cmd.command.run.pc.global_var_buffer = storage;
+
+  if (device->ops->compile_kernel (&fake_cmd, &fake_kernel, device, 0) != 0)
+    return CL_INVALID_OPERATION;
+
+  if (callback)
+    callback (program, dev_i, &fake_cmd);
+  return CL_SUCCESS;
+}
+#endif
+
 /**
 * \brief  Since the ProgramScopeVariables pass creates a hidden kernel
 * for variable initialization, we need to compile (and run) that kernel
@@ -1199,9 +1258,12 @@ pocl_driver_build_opencl_builtins (cl_program program, cl_uint device_i)
 * as arguments.
 *
 * Can be used either to compile the hidden initialization kernel for
-* a poclbinary, or to compile & run program-scope initialization before
-* kernel execution. Should work with all devices that use PoCL's LLVM
-* compilation.
+* a poclbinary (callback NULL; the storage is left alone), or to compile & run
+* program-scope initialization before kernel execution. The latter allocates
+* the storage and runs the initializer once per device under the program
+* lock, and only publishes the storage once it is initialized, so that
+* concurrent launches never see uninitialized variables. Should work with all
+* devices that use PoCL's LLVM compilation.
 *
 * \param [in] program the cl_program used
 * \param [in] device the device used
@@ -1215,64 +1277,34 @@ pocl_driver_build_gvar_init_kernel (cl_program program,
                                     gvar_init_callback_t callback)
 {
 #ifdef ENABLE_HOST_CPU_DEVICES
-  if (device->run_program_scope_variables_pass == CL_FALSE)
+  if (device->run_program_scope_variables_pass == CL_FALSE
+      || program->global_var_total_size[dev_i] == 0)
     return CL_SUCCESS;
 
-  if (program->global_var_total_size[dev_i] > 0 && program->gvar_storage[dev_i] == NULL)
+  if (callback == NULL)
+    return compile_gvar_init_kernel (program, dev_i, device, NULL, NULL);
+
+  int err = CL_SUCCESS;
+  POCL_LOCK_OBJ (program);
+  if (program->gvar_storage[dev_i] == NULL)
     {
-      program->gvar_storage[dev_i] = pocl_aligned_malloc (
-          MAX_EXTENDED_ALIGNMENT, program->global_var_total_size[dev_i]);
-
-      pocl_kernel_metadata_t fake_meta;
-      memset (&fake_meta, 0, sizeof (fake_meta));
-      pocl_kernel_hash_t fake_build_hash;
-
-      SHA1_CTX hash_ctx;
-      pocl_SHA1_Init (&hash_ctx);
-      pocl_SHA1_Update (&hash_ctx, (uint8_t *)program->build_hash[dev_i],
-                        sizeof (SHA1_digest_t));
-      pocl_SHA1_Update (&hash_ctx, (uint8_t *)POCL_GVAR_INIT_KERNEL_NAME,
-                        strlen (POCL_GVAR_INIT_KERNEL_NAME));
-      pocl_SHA1_Final (&hash_ctx, fake_build_hash);
-
-      fake_meta.build_hash = &fake_build_hash;
-
-      struct _cl_kernel fake_kernel;
-      memset (&fake_kernel, 0, sizeof (fake_kernel));
-      fake_kernel.meta = &fake_meta;
-      fake_kernel.name = POCL_GVAR_INIT_KERNEL_NAME;
-      fake_kernel.context = program->context;
-      fake_kernel.program = program;
-
-      _cl_command_node fake_cmd;
-      memset (&fake_cmd, 0, sizeof (_cl_command_node));
-      fake_cmd.program_device_i = dev_i;
-      fake_cmd.device = device;
-      fake_cmd.type = CL_COMMAND_NDRANGE_KERNEL;
-      fake_cmd.command.run.kernel = &fake_kernel;
-      fake_cmd.command.run.hash = fake_meta.build_hash;
-      fake_cmd.command.run.pc.local_size[0] = 1;
-      fake_cmd.command.run.pc.local_size[1] = 1;
-      fake_cmd.command.run.pc.local_size[2] = 1;
-      fake_cmd.command.run.pc.work_dim = 3;
-      fake_cmd.command.run.pc.num_groups[0] = 1;
-      fake_cmd.command.run.pc.num_groups[1] = 1;
-      fake_cmd.command.run.pc.num_groups[2] = 1;
-      fake_cmd.command.run.pc.global_offset[0] = 0;
-      fake_cmd.command.run.pc.global_offset[1] = 0;
-      fake_cmd.command.run.pc.global_offset[2] = 0;
-      fake_cmd.command.run.pc.global_var_buffer = program->gvar_storage[dev_i];
-
-      if (device->ops->compile_kernel (&fake_cmd, &fake_kernel, device, 0)
-          != 0)
-        return CL_INVALID_OPERATION;
-
-      if (callback) {
-        callback (program, dev_i, &fake_cmd);
-      }
+      void *storage = pocl_aligned_malloc (
+        MAX_EXTENDED_ALIGNMENT, program->global_var_total_size[dev_i]);
+      if (storage == NULL)
+        err = CL_OUT_OF_HOST_MEMORY;
+      else
+        err = compile_gvar_init_kernel (program, dev_i, device, storage,
+                                        callback);
+      if (err == CL_SUCCESS)
+        program->gvar_storage[dev_i] = storage;
+      else
+        pocl_aligned_free (storage);
     }
-#endif
+  POCL_UNLOCK_OBJ (program);
+  return err;
+#else
   return CL_SUCCESS;
+#endif
 }
 
 
diff --git a/tests/regression/test_program_scope_vars.cpp b/tests/regression/test_program_scope_vars.cpp
index c596bb291..83664fa53 100644
--- a/tests/regression/test_program_scope_vars.cpp
+++ b/tests/regression/test_program_scope_vars.cpp
@@ -148,6 +148,28 @@ kernel void reader( global float2* dest, float2 ptr_write_val ) {
 
 )raw";
 
+/* Initializers must run even if the program binaries are queried (which
+   compiles the initializer kernel) before the first launch, and again after
+   the program is rebuilt. */
+static char programFiveSourceCode[] = R"raw(
+
+global int initVar = 42;
+global int initArr[4] = { 1, 2, 3, 4 };
+
+kernel void read_init (global int *out) {
+  out[0] = initVar;
+  for (int i = 0; i < 4; ++i)
+    out[1 + i] = initArr[i];
+}
+
+kernel void clobber_init () {
+  initVar = -1;
+  for (int i = 0; i < 4; ++i)
+    initArr[i] = -1;
+}
+
+)raw";
+
 int
 main(void)
 {
@@ -446,6 +468,60 @@ main(void)
         std::cout << "TEST_GVAR_PTR matching res: " << matching_res << "\n";
         errors += (matching_res != 8 ? 1 : 0);
 
+        cl::Program::Sources sources5({programFiveSourceCode});
+        cl::Program program5(context, sources5);
+        program5.build(devices, "-cl-std=CL3.0");
+        program5.getInfo<CL_PROGRAM_BINARIES>();
+
+        cl::Buffer outBuffer5 = cl::Buffer(
+            context, CL_MEM_READ_WRITE, 5 * sizeof(cl_int), nullptr);
+        const cl_int initExpected[5] = { 42, 1, 2, 3, 4 };
+
+        for (int build = 0; build < 2; ++build) {
+          if (build > 0)
+            program5.build(devices, "-cl-std=CL3.0");
+
+          cl::Kernel read_init(program5, "read_init");
+          cl::Kernel clobber_init(program5, "clobber_init");
+          read_init.setArg(0, outBuffer5);
+          queue.enqueueNDRangeKernel(
+              read_init,
+              cl::NullRange,
+              cl::NDRange(1),
+              cl::NullRange);
+
+          cl_int initOut[5] = { 0 };
+          queue.enqueueReadBuffer(
+              outBuffer5,
+              CL_TRUE, // block
+              0,
+              sizeof(initOut),
+              (void*) &initOut[0]);
+
+          matching_res = 0;
+          for (unsigned i = 0; i < 5; ++i) {
+            if (initOut[i] == initExpected[i]) {
+              ++matching_res;
+            } else {
+              std::cout << "FAIL at " << i << " build " << build
+                        << " expected: " << initExpected[i]
+                        << " got: " << initOut[i] << "\n";
+            }
+          }
+
+          std::cout << "TEST_GVAR_INIT build " << build
+                    << " matching res: " << matching_res << "\n";
+          errors += (matching_res != 5 ? 1 : 0);
+
+          /* The rebuild must start from the initializers again. */
+          queue.enqueueNDRangeKernel(
+              clobber_init,
+              cl::NullRange,
+              cl::NDRange(1),
+              cl::NullRange);
+          queue.finish();
+        }
+
     }
     catch (cl::Error &err) {
         std::cerr << "ERROR: " << err.what() << "(" << err.err() << ")"
-- 
2.56.0

