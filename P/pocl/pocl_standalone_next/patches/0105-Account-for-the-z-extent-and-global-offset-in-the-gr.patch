From a6bf0288572b676c626f27f46e4e859c43e7ba69 Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Mon, 19 Oct 2026 17:07:11 +0200
Subject: [PATCH] Account for the z extent and global offset in the grid width

pocl_cmd_max_grid_dim_width multiplied the z local size with itself instead
of with the number of groups, and ignored the global offset. A grid that is
wide only in z, or that is small but offset far from the origin, therefore
got the work-group function specialized for small grids, whose range
assumptions on the group counts and global offsets then let the optimizer
fold e.g. get_num_groups(2) > 65535 or get_global_offset(0) > 65535 to false.
---
 lib/CL/devices/common.c           |  11 ++-
 tests/regression/CMakeLists.txt   |   3 +
 tests/regression/test_tall_grid.c | 121 ++++++++++++++++++++++++++++++
 3 files changed, 131 insertions(+), 4 deletions(-)
 create mode 100644 tests/regression/test_tall_grid.c

diff --git a/lib/CL/devices/common.c b/lib/CL/devices/common.c
index cdab08b6c..812ed2ed2 100644
--- a/lib/CL/devices/common.c
+++ b/lib/CL/devices/common.c
@@ -969,13 +969,16 @@ pocl_fill_dev_sampler_t (dev_sampler_t *ds, struct pocl_argument *parg)
 }
 
 /* Returns the width of the widest dimension in the grid of the given
-   run command. */
+   run command, counted from the origin: the small-grid work-group functions
+   assume that both the group counts and the global offsets are bounded. */
 size_t
 pocl_cmd_max_grid_dim_width (_cl_command_run *cmd)
 {
-  return max (max (cmd->pc.local_size[0] * cmd->pc.num_groups[0],
-                   cmd->pc.local_size[1] * cmd->pc.num_groups[1]),
-              cmd->pc.local_size[2] * cmd->pc.local_size[2]);
+  size_t width = 0;
+  for (unsigned d = 0; d < 3; ++d)
+    width = max (width, cmd->pc.global_offset[d]
+                          + cmd->pc.local_size[d] * cmd->pc.num_groups[d]);
+  return width;
 }
 
 
diff --git a/tests/regression/CMakeLists.txt b/tests/regression/CMakeLists.txt
index aca46e0f0..a1130bb41 100644
--- a/tests/regression/CMakeLists.txt
+++ b/tests/regression/CMakeLists.txt
@@ -46,6 +46,7 @@ set(C_PROGRAMS_TO_BUILD test_assign_loop_variable_to_privvar_makes_it_local
      test_large_private_workgroup
      test_stack_estimate_builtins
      test_sanitize_divrem
+     test_tall_grid
 )
 if(UNIX)
   list(APPEND C_PROGRAMS_TO_BUILD test_signal_handlers)
@@ -199,6 +200,8 @@ add_test_pocl(NAME "regression/spirv_intel_subgroups" WORKITEM_HANDLER "loops;lo
 
 add_test_pocl(NAME "regression/divergent_implicit_barrier_entry" WORKITEM_HANDLER "loops;loopvec;cbs;" COMMAND "test_divergent_implicit_barrier_entry")
 
+add_test_pocl(NAME "regression/tall_grid" COMMAND "test_tall_grid")
+
 add_test_pocl(NAME "regression/uniform_implicit_barrier_entry" WORKITEM_HANDLER "loops;loopvec;cbs;" COMMAND "test_uniform_implicit_barrier_entry")
 
 add_test_pocl(NAME "regression/localmem_load_across_barrier" WORKITEM_HANDLER "loops;loopvec;cbs;" COMMAND "test_localmem_load_across_barrier")
diff --git a/tests/regression/test_tall_grid.c b/tests/regression/test_tall_grid.c
new file mode 100644
index 000000000..f03aa5362
--- /dev/null
+++ b/tests/regression/test_tall_grid.c
@@ -0,0 +1,121 @@
