Backport of pcre2-10.48-Fix-invalid-UTF-backwards-scans.patch, from https://github.com/PCRE2Project/pcre2/commit/92bfa3fd49903057a903ddfa82c92d66ae16a607 on the release/pcre2-10.42 branch.

From 92bfa3fd49903057a903ddfa82c92d66ae16a607 Mon Sep 17 00:00:00 2001
From: Nicholas Wilson <nicholas@nicholaswilson.me.uk>
Date: Thu, 27 Aug 2026 16:52:16 +0100
Subject: [PATCH] Backport of pcre2-10.48-Fix-invalid-UTF-backwards-scans.patch

Cherry-pick of 4889caf31a4c5a6b3c051f0031bf2dbd78f2c287

Fix invalid UTF backwards-scan reads; see GHSA-9qww-pwc4-77qq for details
---
 src/pcre2_extuni.c       | 10 +++++-----
 src/pcre2_match.c        |  8 ++++----
 testdata/testinput10     |  6 ++++++
 testdata/testinput12     |  6 ++++++
 testdata/testoutput10    |  7 +++++++
 testdata/testoutput12-16 |  7 +++++++
 testdata/testoutput12-32 |  7 +++++++
 7 files changed, 42 insertions(+), 9 deletions(-)

diff --git a/src/pcre2_extuni.c b/src/pcre2_extuni.c
index b23946b..b0e7335 100644
--- a/src/pcre2_extuni.c
+++ b/src/pcre2_extuni.c
@@ -57,12 +57,12 @@ support, because some compilers do not like functionless source files. */
 
 #ifndef SUPPORT_UNICODE
 PCRE2_SPTR
-PRIV(extuni)(uint32_t c, PCRE2_SPTR eptr, PCRE2_SPTR start_subject,
+PRIV(extuni)(uint32_t c, PCRE2_SPTR eptr, PCRE2_SPTR check_subject,
   PCRE2_SPTR end_subject, BOOL utf, int *xcount)
 {
 (void)c;
 (void)eptr;
-(void)start_subject;
+(void)check_subject;
 (void)end_subject;
 (void)utf;
 (void)xcount;
@@ -79,7 +79,7 @@ return NULL;
 Arguments:
   c              the first character
   eptr           pointer to next character
-  start_subject  pointer to start of subject
+  check_subject  pointer to start of validated subject
   end_subject    pointer to end of subject
   utf            TRUE if in UTF mode
   xcount         pointer to count of additional characters,
@@ -89,7 +89,7 @@ Returns:         pointer after the end of the sequence
 */
 
 PCRE2_SPTR
-PRIV(extuni)(uint32_t c, PCRE2_SPTR eptr, PCRE2_SPTR start_subject,
+PRIV(extuni)(uint32_t c, PCRE2_SPTR eptr, PCRE2_SPTR check_subject,
   PCRE2_SPTR end_subject, BOOL utf, int *xcount)
 {
 int lgb = UCD_GRAPHBREAK(c);
@@ -113,7 +113,7 @@ while (eptr < end_subject)
 
     /* bptr is pointing to the left-hand character */
 
-    while (bptr > start_subject)
+    while (bptr > check_subject)
       {
       bptr--;
       if (utf)
diff --git a/src/pcre2_match.c b/src/pcre2_match.c
index 83ab2bc..68e9147 100644
--- a/src/pcre2_match.c
+++ b/src/pcre2_match.c
@@ -2579,7 +2579,7 @@ fprintf(stderr, "++ op=%d\n", *Fecode);
     else
       {
       GETCHARINCTEST(fc, Feptr);
-      Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject, mb->end_subject, utf,
+      Feptr = PRIV(extuni)(fc, Feptr, mb->check_subject, mb->end_subject, utf,
         NULL);
       }
     CHECK_PARTIAL();
@@ -2932,7 +2932,7 @@ fprintf(stderr, "++ op=%d\n", *Fecode);
           else
             {
             GETCHARINCTEST(fc, Feptr);
-            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject,
+            Feptr = PRIV(extuni)(fc, Feptr, mb->check_subject,
               mb->end_subject, utf, NULL);
             }
           CHECK_PARTIAL();
@@ -3754,7 +3754,7 @@ fprintf(stderr, "++ op=%d\n", *Fecode);
           else
             {
             GETCHARINCTEST(fc, Feptr);
-            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject, mb->end_subject,
+            Feptr = PRIV(extuni)(fc, Feptr, mb->check_subject, mb->end_subject,
               utf, NULL);
             }
           CHECK_PARTIAL();
@@ -4335,7 +4335,7 @@ fprintf(stderr, "++ op=%d\n", *Fecode);
           else
             {
             GETCHARINCTEST(fc, Feptr);
-            Feptr = PRIV(extuni)(fc, Feptr, mb->start_subject, mb->end_subject,
+            Feptr = PRIV(extuni)(fc, Feptr, mb->check_subject, mb->end_subject,
               utf, NULL);
             }
           CHECK_PARTIAL();
diff --git a/testdata/testinput10 b/testdata/testinput10
index 53e37cb..ef9c311 100644
--- a/testdata/testinput10
+++ b/testdata/testinput10
@@ -555,6 +555,12 @@
     AAA\x80BXYZ 
     AAA\x80BBXYZ 
 
+# Backward scans must not enter the invalid prefix before check_subject.
+
+/\X\X/utf,match_invalid_utf
+\= Expect no match
+    \x80\x{1f1e6}\x{1f1e7}
+
 # -------------------------------------
 
 /(*UTF)(?=\x{123})/I
