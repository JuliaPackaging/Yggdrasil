The arm/aarch64 initreg backends include the raw kernel UAPI <linux/uio.h>
after "system.h" has already pulled in glibc's <bits/uio.h> via <fcntl.h>.
Neither header guards against the other on our sysroots, so `struct iovec`
ends up being defined twice:

    sys-root/usr/include/linux/uio.h:17:8: error: redefinition of 'struct iovec'
    sys-root/usr/include/bits/uio.h:43:8: note: originally defined here

These files only need `struct iovec` for their PTRACE_GETREGSET calls, so
include the libc's own <sys/uio.h>, which is properly guarded.

--- a/backends/aarch64_initreg.c
+++ b/backends/aarch64_initreg.c
@@ -33,7 +33,7 @@
 #include "system.h"
 #include <assert.h>
 #if defined(__aarch64__) && defined(__linux__)
-# include <linux/uio.h>
+# include <sys/uio.h>
 # include <sys/user.h>
 # include <sys/ptrace.h>
 # include <asm/ptrace.h>
--- a/backends/arm_initreg.c
+++ b/backends/arm_initreg.c
@@ -38,7 +38,7 @@
 #endif
 
 #ifdef __aarch64__
-# include <linux/uio.h>
+# include <sys/uio.h>
 # include <sys/user.h>
 # include <sys/ptrace.h>
 /* Deal with old glibc defining user_pt_regs instead of user_regs_struct.  */
