             endif()
         else()
-            ADD_CUSTOM_COMMAND(TARGET iqtree3 POST_BUILD COMMAND copy "Release\\iqtree3${EXE_SUFFIX}.exe" "Release\\iqtree3${EXE_SUFFIX}-click.exe")
+            ADD_CUSTOM_COMMAND(TARGET iqtree3 POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy "Release\\iqtree3${EXE_SUFFIX}.exe" "Release\\iqtree3${EXE_SUFFIX}-click.exe")
             if (USE_CMAPLE_AA STREQUAL "ON")
-            	ADD_CUSTOM_COMMAND(TARGET iqtree3-aa POST_BUILD COMMAND copy "Release\\iqtree3-aa${EXE_SUFFIX}.exe" "Release\\iqtree3-aa${EXE_SUFFIX}-click.exe")
+            	ADD_CUSTOM_COMMAND(TARGET iqtree3-aa POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy "Release\\iqtree3-aa${EXE_SUFFIX}.exe" "Release\\iqtree3-aa${EXE_SUFFIX}-click.exe")
             endif()
         endif()
     else()
