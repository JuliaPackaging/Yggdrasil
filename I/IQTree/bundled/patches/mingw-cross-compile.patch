     if (MSVC)
         if (CLANG_UNDER_VS)
-            ADD_CUSTOM_COMMAND(TARGET iqtree3 POST_BUILD COMMAND copy "iqtree3${EXE_SUFFIX}.exe" "iqtree3${EXE_SUFFIX}-click.exe")
+            ADD_CUSTOM_COMMAND(TARGET iqtree3 POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy "iqtree3${EXE_SUFFIX}.exe" "iqtree3${EXE_SUFFIX}-click.exe")
