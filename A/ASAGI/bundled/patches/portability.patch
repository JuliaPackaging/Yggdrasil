Portability: thread pinning (pthread_setaffinity_np) and sched_getcpu are Linux-only, execinfo.h (backtrace) is not available on musl, FreeBSD and Windows, and the DLL has to be installed to bindir on Windows.
https://github.com/TUM-I5/ASAGI (upstream PR to be opened)

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -310,6 +310,7 @@
     install( TARGETS asagi-shared
         EXPORT asagi-shared-targets 
         LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
         ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} )
     install(FILES include/asagi.h include/asagi.f90
         DESTINATION ${CMAKE_INSTALL_INCLUDEDIR} )
@@ -326,6 +327,7 @@
     install( TARGETS asagi-static
         EXPORT asagi-static-targets
         LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+        RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
         ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} )
     install(FILES include/asagi.h include/asagi.f90
         DESTINATION ${CMAKE_INSTALL_INCLUDEDIR} )
