   // Check that RISCV64 upgrades -n64 to -n32:64.
   EXPECT_EQ(UpgradeDataLayoutString("e-m:e-p:64:64-i64:64-i128:128-n64-S128",
@@ -152,24 +161,27 @@ TEST(DataLayoutUpgradeTest, NoDataLayoutUpgrade) {
