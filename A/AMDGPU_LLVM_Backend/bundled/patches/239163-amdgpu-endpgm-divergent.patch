From d945efa78dd96d441f28ed10176cf2439bdb048c Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Thu, 5 Nov 2026 10:55:09 +0100
Subject: [PATCH] [AMDGPU] Lower llvm.amdgcn.endpgm like a trap without a
 handler

llvm.amdgcn.endpgm was selected straight to S_ENDPGM, a terminator, wherever
the call was. That is only valid when the call ends its block. In a divergent
region, AMDGPUUnifyDivergentExitNodes replaces the unreachable after the call
by a branch to the unified exit, so the block continues after S_ENDPGM with the
structurizer's control flow, which the machine verifier rejects ("Non-terminator
instruction after the first terminator"). Nothing else notices until branch
relaxation has to relax a conditional branch out of such a block: analyzeBranch
fails on it, which asserts, or crashes on a null target in release builds.
Julia's AMDGPU.jl ends kernels with this intrinsic when they throw, so kernels
with a divergent error path have the malformed code, and large ones crash.

Lower the intrinsic as llvm.trap is lowered without a trap handler, through
ENDPGM_TRAP in SelectionDAG and legalizeTrapEndpgm in GlobalISel. These keep a
lone S_ENDPGM where it ends its block, and otherwise split the block and branch
to a new block with the S_ENDPGM when EXEC is non-zero, so the whole wave still
ends as soon as an active lane reaches the call.

Backport to 23.1.3 of the fix on tb/amdgpu-endpgm-divergent, without its tests.
---
 llvm/lib/Target/AMDGPU/AMDGPULegalizerInfo.cpp        | 4 ++++
 llvm/lib/Target/AMDGPU/AMDGPURegBankLegalizeRules.cpp | 1 -
 llvm/lib/Target/AMDGPU/SIISelLowering.cpp             | 5 +++++
 llvm/lib/Target/AMDGPU/SIInstructions.td              | 3 ++-
 llvm/lib/Target/AMDGPU/SOPInstructions.td             | 5 -----
 5 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/llvm/lib/Target/AMDGPU/AMDGPULegalizerInfo.cpp b/llvm/lib/Target/AMDGPU/AMDGPULegalizerInfo.cpp
index 2180ce67d576..e185702e8515 100644
--- a/llvm/lib/Target/AMDGPU/AMDGPULegalizerInfo.cpp
+++ b/llvm/lib/Target/AMDGPU/AMDGPULegalizerInfo.cpp
@@ -8236,6 +8236,10 @@ bool AMDGPULegalizerInfo::legalizeIntrinsic(LegalizerHelper &Helper,
       MI.eraseFromParent();
     }
     return true;
+  case Intrinsic::amdgcn_endpgm:
+    // s_endpgm is a terminator, but the call need not end its block (see
+    // SITargetLowering::LowerINTRINSIC_VOID).
+    return legalizeTrapEndpgm(MI, MRI, B);
   case Intrinsic::amdgcn_if:
   case Intrinsic::amdgcn_else: {
     MachineInstr *Br = nullptr;
diff --git a/llvm/lib/Target/AMDGPU/AMDGPURegBankLegalizeRules.cpp b/llvm/lib/Target/AMDGPU/AMDGPURegBankLegalizeRules.cpp
index 7f7225ad6d31..67f8d16e86b6 100644
--- a/llvm/lib/Target/AMDGPU/AMDGPURegBankLegalizeRules.cpp
+++ b/llvm/lib/Target/AMDGPU/AMDGPURegBankLegalizeRules.cpp
@@ -1806,7 +1806,6 @@ RegBankLegalizeRules::RegBankLegalizeRules(const GCNSubtarget &_ST,
 
   // Intrinsics with no register operands.
   addRulesForIOpcs({amdgcn_asyncmark,
-                    amdgcn_endpgm,
                     amdgcn_iglp_opt,
                     amdgcn_init_exec,
                     amdgcn_s_barrier,
diff --git a/llvm/lib/Target/AMDGPU/SIISelLowering.cpp b/llvm/lib/Target/AMDGPU/SIISelLowering.cpp
index 3ea4a99b6f6c..4e9c26d784c3 100644
--- a/llvm/lib/Target/AMDGPU/SIISelLowering.cpp
+++ b/llvm/lib/Target/AMDGPU/SIISelLowering.cpp
@@ -12273,6 +12273,11 @@ SDValue SITargetLowering::LowerINTRINSIC_VOID(SDValue Op,
   unsigned IntrinsicID = Op.getConstantOperandVal(1);
 
   switch (IntrinsicID) {
+  case Intrinsic::amdgcn_endpgm:
+    // s_endpgm is a terminator, but the call need not end its block: in a
+    // divergent region, the unreachable after it becomes a branch to the
+    // region's exit. Lower it like a trap, which splits the block if needed.
+    return lowerTrapEndpgm(Op, DAG);
   case Intrinsic::amdgcn_exp_compr: {
     if (!Subtarget->hasCompressedExport()) {
       DAG.getContext()->diagnose(DiagnosticInfoUnsupported(
diff --git a/llvm/lib/Target/AMDGPU/SIInstructions.td b/llvm/lib/Target/AMDGPU/SIInstructions.td
index d978735a92db..b535757a5452 100644
--- a/llvm/lib/Target/AMDGPU/SIInstructions.td
+++ b/llvm/lib/Target/AMDGPU/SIInstructions.td
@@ -95,7 +95,8 @@ defm V_INTERP_MOV_F32 : VINTRP_m <
 // Pseudo Instructions
 //===----------------------------------------------------------------------===//
 
-// Insert a branch to an endpgm block to use as a fallback trap.
+// Insert a branch to an endpgm block, for llvm.amdgcn.endpgm and as a fallback
+// trap.
 def ENDPGM_TRAP : SPseudoInstSI<
   (outs), (ins),
   [(AMDGPUendpgm_trap)],
diff --git a/llvm/lib/Target/AMDGPU/SOPInstructions.td b/llvm/lib/Target/AMDGPU/SOPInstructions.td
index cd7c43972813..4fcfb51b02ba 100644
--- a/llvm/lib/Target/AMDGPU/SOPInstructions.td
+++ b/llvm/lib/Target/AMDGPU/SOPInstructions.td
@@ -1936,11 +1936,6 @@ def : GCNPat <
     (S_ENDPGM (i16 0))
 >;
 
-def : GCNPat <
-  (int_amdgcn_endpgm),
-    (S_ENDPGM (i16 0))
->;
-
 def : GCNPat <
   (i64 (UniformUnaryFrag<ctpop> i64:$src)),
     (i64 (REG_SEQUENCE SReg_64,
