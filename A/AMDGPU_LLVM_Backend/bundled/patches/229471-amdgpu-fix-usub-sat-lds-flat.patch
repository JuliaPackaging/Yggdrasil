From 0a894652d6b2ead996c4f54b647fcead1f7e47ca Mon Sep 17 00:00:00 2001
From: Tim Besard <tim.besard@gmail.com>
Date: Tue, 6 Oct 2026 18:01:43 +0200
Subject: [PATCH] AMDGPU: Fix selection of atomicrmw usub_sat for LDS and flat

usub_sat was treated as legal on all address spaces once the subtarget
had the global form (gfx10.3+), but the LDS form (ds_sub_clamp_u32) and
the flat form (flat_atomic_sub_clamp_u32) only exist on gfx12+, and the
latter had no selection pattern at all. As a result, LDS on gfx10.3/11
and flat on gfx12 failed to select with both SelectionDAG and
GlobalISel, as did flat on gfx10.3/11 whenever the fine-grained memory
fallback to cmpxchg did not apply. LLVM 21 expanded all of these to a
cmpxchg loop.

Check the address-space specific predicates before treating the
operation as legal, and add the missing flat pattern.

Fixes #229442
---
 llvm/lib/Target/AMDGPU/AMDGPU.td              |   19 +-
 llvm/lib/Target/AMDGPU/FLATInstructions.td    |    2 +
 llvm/lib/Target/AMDGPU/SIISelLowering.cpp     |   11 +-
 .../test/CodeGen/AMDGPU/atomicrmw_usub_sat.ll | 1008 +++++++++++++++++
 4 files changed, 1030 insertions(+), 10 deletions(-)

diff --git a/llvm/lib/Target/AMDGPU/AMDGPU.td b/llvm/lib/Target/AMDGPU/AMDGPU.td
index 8aed06ef918e..62abc9501dcf 100644
--- a/llvm/lib/Target/AMDGPU/AMDGPU.td
+++ b/llvm/lib/Target/AMDGPU/AMDGPU.td
@@ -911,10 +911,19 @@ defm AtomicDsPkAdd16Insts : AMDGPUSubtargetFeature<"atomic-ds-pk-add-16-insts",
   "ds_pk_add_rtn_f16 instructions"
 >;
 
+defm AtomicDsCondSubClampInsts : AMDGPUSubtargetFeature<"atomic-ds-cond-sub-clamp-insts",
+  "Has ds_cond_sub_u32, ds_cond_sub_rtn_u32, ds_sub_clamp_u32 and "
+  "ds_sub_clamp_rtn_u32 instructions"
+>;
+
 defm AtomicFlatPkAdd16Insts : AMDGPUSubtargetFeature<"atomic-flat-pk-add-16-insts",
   "Has flat_atomic_pk_add_f16 and flat_atomic_pk_add_bf16 instructions"
 >;
 
+defm AtomicCondSubClampFlatInsts : AMDGPUSubtargetFeature<"atomic-cond-sub-clamp-flat-insts",
+  "Has flat_atomic_cond_sub_u32 and flat_atomic_sub_clamp_u32 instructions"
+>;
+
 defm AtomicFaddRtnInsts : AMDGPUSubtargetFeature<"atomic-fadd-rtn-insts",
   "Has buffer_atomic_add_f32 and global_atomic_add_f32 instructions that "
   "return original value",
@@ -1619,6 +1628,7 @@ def FeatureGFX12 : GCNSubtargetFeatureGeneration<"GFX12",
    FeatureUnalignedDSAccess, FeatureTrue16BitInsts,
    FeatureDefaultComponentBroadcast, FeatureMaxHardClauseLength32,
    FeatureAtomicFMinFMaxF32GlobalInsts, FeatureAtomicFMinFMaxF32FlatInsts,
+   FeatureAtomicDsCondSubClampInsts, FeatureAtomicCondSubClampFlatInsts,
    FeatureIEEEMinimumMaximumInsts, FeatureSALUMinimumMaximumInsts,
    FeatureMinimum3Maximum3F32, FeatureMinimum3Maximum3F16,
    FeatureAgentScopeFineGrainedRemoteMemoryAtomics, FeatureFlatOffsetBits24,
@@ -1647,6 +1657,7 @@ def FeatureGFX13 : GCNSubtargetFeatureGeneration<"GFX13",
    FeatureUnalignedDSAccess, FeatureTrue16BitInsts,
    FeatureDefaultComponentBroadcast, FeatureMaxHardClauseLength32,
    FeatureAtomicFMinFMaxF32GlobalInsts, FeatureAtomicFMinFMaxF32FlatInsts,
+   FeatureAtomicDsCondSubClampInsts, FeatureAtomicCondSubClampFlatInsts,
    FeatureIEEEMinimumMaximumInsts, FeatureSALUMinimumMaximumInsts,
    FeatureMinimum3Maximum3F32, FeatureMinimum3Maximum3F16,
    FeatureAgentScopeFineGrainedRemoteMemoryAtomics, FeatureFlatOffsetBits24,
@@ -2720,10 +2731,6 @@ def isGFX13Plus :
   Predicate<"Subtarget->getGeneration() >= AMDGPUSubtarget::GFX13">,
   AssemblerPredicate<(all_of FeatureGFX13Insts)>;
 
-def HasAtomicCondSubClampFlatInsts :
-  Predicate<"Subtarget->getGeneration() >= AMDGPUSubtarget::GFX12">,
-  AssemblerPredicate<(all_of FeatureGFX12Insts)>;
-
