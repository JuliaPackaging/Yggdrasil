index 0000000..04ae09c
--- /dev/null
+++ b/deps/LLVMExtra/lib/exports_def.cmake
@@ -0,0 +1,17 @@
+# write a module definition file that exports the LLVM C API, LLVMExtra and the functions
+# that support JIT-compiled code, as defined by the object files and archives in INPUTS
+file(STRINGS ${INPUTS} inputs)
+set(symbols)
+foreach(input ${inputs})
+  execute_process(COMMAND ${NM} --defined-only --extern-only --format=posix ${input}
+                  OUTPUT_VARIABLE output COMMAND_ERROR_IS_FATAL ANY)
+  string(REGEX MATCHALL "(^|\n)${PREFIX}(LLVM|llvm_orc_)[A-Za-z0-9_]* T" matches "${output}")
+  foreach(match ${matches})
+    string(REGEX REPLACE "^\n?${PREFIX}([A-Za-z0-9_]+) T$" "\\1" symbol "${match}")
+    list(APPEND symbols ${symbol})
+  endforeach()
+endforeach()
+list(REMOVE_DUPLICATES symbols)
+list(SORT symbols)
+list(JOIN symbols "\n  " exports)
+file(WRITE ${OUTPUT} "EXPORTS\n  ${exports}\n")
