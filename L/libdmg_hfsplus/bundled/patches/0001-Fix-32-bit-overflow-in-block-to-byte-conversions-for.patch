From 0bac693ef009f8a17aef46937b31e8185e2032d0 Mon Sep 17 00:00:00 2001
From: Janis Erdmanis <janis@janiserdmanis.org>
Date: Sun, 27 Sep 2026 09:38:57 +0000
Subject: [PATCH 1/2] Fix 32-bit overflow in block-to-byte conversions for
 volumes >= 4 GiB

Allocation block numbers, block counts and the block size are all 32-bit
fields, and several places multiplied them together in 32 bits. For
volumes of 4 GiB and larger the product wraps:

* hfsplus add/addall: allocate() zeroes each newly allocated block at
  curBlock * blockSize. Past 4 GiB this write wraps to the start of the
  volume and clobbers the volume header and B-tree nodes, and the
  operation aborts with "BTree inconsistent!".

* dmg build: the volume size totalBlocks * blockSize wraps, so the main
  blkx, the partition map and the koly sector count describe only
  (size mod 4 GiB) of the volume. The checksums cover the truncated data,
  so hdiutil verify accepts the image, but the HFS+ volume in it is
  broken.

Add hfsBlocksToBytes(), which forms the product in 64 bits, and use it
for these conversions. buildDmg now refuses volumes whose sector count
does not fit the 32-bit partition map fields instead of truncating them.
---
 dmg/dmglib.c           | 22 +++++++++++++++++-----
 hfs/hfslib.c           |  4 +++-
 hfs/rawfile.c          |  2 +-
 includes/hfs/hfsplus.h |  8 ++++++++
 4 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/dmg/dmglib.c b/dmg/dmglib.c
index 1f16056..60c25cc 100644
--- a/dmg/dmglib.c
+++ b/dmg/dmglib.c
@@ -1,4 +1,5 @@
 #include <string.h>
+#include <inttypes.h>
 #include "common.h"
 #include "abstractfile.h"
 #include <dmg/attribution.h>
@@ -114,10 +115,21 @@ int buildDmg(AbstractFile* abstractIn, AbstractFile* abstractOut, unsigned int B
 	uint32_t plistSize;
 	uint32_t dataForkChecksum;
 
+	uint64_t volumeSize;
+	uint32_t volumeSectors;
+
 	io = IOFuncFromAbstractFile(abstractIn);
 	ASSERT(volume = openVolume(io), "parse HFS volume");
 	volumeHeader = volume->volumeHeader;
 
+	volumeSize = hfsBlocksToBytes(volume, volumeHeader->totalBlocks);
+	/* The Apple partition map stores sector counts in 32 bits. */
+	if(volumeSize / SECTOR_SIZE > UINT32_MAX) {
+		fprintf(stderr, "HFS+ volume too large for an Apple partition map (%" PRIu64 " bytes)\n", volumeSize);
+		return FALSE;
+	}
+	volumeSectors = volumeSize / SECTOR_SIZE;
+
 
 	if(volumeHeader->signature != HFSX_SIGNATURE) {
 		printf("Warning: ASR data only reverse engineered for case-sensitive HFS+ volumes\n");fflush(stdout);
@@ -132,9 +144,9 @@ int buildDmg(AbstractFile* abstractIn, AbstractFile* abstractOut, unsigned int B
 
 	printf("Creating and writing DDM and partition map...\n"); fflush(stdout);
 
-	DDM = createDriverDescriptorMap((volumeHeader->totalBlocks * volumeHeader->blockSize)/SECTOR_SIZE, BlockSize);
+	DDM = createDriverDescriptorMap(volumeSectors, BlockSize);
 
-	partitions = createApplePartitionMap((volumeHeader->totalBlocks * volumeHeader->blockSize)/SECTOR_SIZE, HFSX_VOLUME_TYPE, BlockSize);
+	partitions = createApplePartitionMap(volumeSectors, HFSX_VOLUME_TYPE, BlockSize);
 
 	int pNum = writeDriverDescriptorMap(-1, abstractOut, DDM, BlockSize, &CRCProxy, (void*) (&dataForkToken), &resources, comp, runSectors);
 	free(DDM);
@@ -158,7 +170,7 @@ int buildDmg(AbstractFile* abstractIn, AbstractFile* abstractOut, unsigned int B
 		attribution->beforeMainBlkx(attribution, abstractOut, &dataForkToken);
 	}
 
-	blkx = insertBLKX(abstractOut, abstractIn, USER_OFFSET, (volumeHeader->totalBlocks * volumeHeader->blockSize)/SECTOR_SIZE,
+	blkx = insertBLKX(abstractOut, abstractIn, USER_OFFSET, volumeSectors,
 				pNum, CHECKSUM_UDIF_CRC32, &BlockSHA1CRC, &uncompressedToken, &CRCProxy, &dataForkToken, volume, attribution, comp, runSectors);
 
 	AttributionResource attributionResource;
@@ -213,7 +225,7 @@ int buildDmg(AbstractFile* abstractIn, AbstractFile* abstractOut, unsigned int B
 
 	printf("Writing free partition...\n"); fflush(stdout);
 
-	pNum = writeFreePartition(pNum, abstractOut, USER_OFFSET + (volumeHeader->totalBlocks * volumeHeader->blockSize)/SECTOR_SIZE,
+	pNum = writeFreePartition(pNum, abstractOut, USER_OFFSET + volumeSectors,
 			(FREE_SIZE + (BlockSize / SECTOR_SIZE / 2)) / (BlockSize / SECTOR_SIZE) * (BlockSize / SECTOR_SIZE), &resources);
 
 	dataForkChecksum = dataForkToken.crc;
@@ -268,7 +280,7 @@ int buildDmg(AbstractFile* abstractIn, AbstractFile* abstractOut, unsigned int B
 	printf("Master checksum: %x\n", koly.fUDIFMasterChecksum.data[0]); fflush(stdout);
 
 	koly.fUDIFImageVariant = kUDIFDeviceImageType;
-	koly.fUDIFSectorCount = (volumeHeader->totalBlocks * volumeHeader->blockSize)/SECTOR_SIZE
+	koly.fUDIFSectorCount = volumeSectors
 		+ ((EXTRA_SIZE + (BlockSize / SECTOR_SIZE / 2)) / (BlockSize / SECTOR_SIZE) * (BlockSize / SECTOR_SIZE));
 	koly.reserved2 = 0;
 	koly.reserved3 = 0;
diff --git a/hfs/hfslib.c b/hfs/hfslib.c
index 530e9a9..34a613c 100644
--- a/hfs/hfslib.c
+++ b/hfs/hfslib.c
@@ -731,7 +731,9 @@ void hfs_ls(Volume* volume, const char* path) {
 		printf("No such file or directory\n");
 	}
 
-	printf("Total filesystem size: %d, free: %d\n", (volume->volumeHeader->totalBlocks - volume->volumeHeader->freeBlocks) * volume->volumeHeader->blockSize, volume->volumeHeader->freeBlocks * volume->volumeHeader->blockSize);
+	printf("Total filesystem size: %" PRIu64 ", free: %" PRIu64 "\n",
+		hfsBlocksToBytes(volume, volume->volumeHeader->totalBlocks - volume->volumeHeader->freeBlocks),
+		hfsBlocksToBytes(volume, volume->volumeHeader->freeBlocks));
 
 	free(record);
 }
diff --git a/hfs/rawfile.c b/hfs/rawfile.c
index 9023acf..f2f57aa 100644
--- a/hfs/rawfile.c
+++ b/hfs/rawfile.c
@@ -88,7 +88,7 @@ int allocate(RawFile* rawFile, off_t size) {
 				}
 
 				/* zero out allocated block */
-				ASSERT(WRITE(volume->image, curBlock * volume->volumeHeader->blockSize, volume->volumeHeader->blockSize, zeros), "WRITE");
+				ASSERT(WRITE(volume->image, hfsBlocksToBytes(volume, curBlock), volume->volumeHeader->blockSize, zeros), "WRITE");
 
 				setBlockUsed(volume, curBlock, TRUE);
 				volume->volumeHeader->freeBlocks--;
diff --git a/includes/hfs/hfsplus.h b/includes/hfs/hfsplus.h
index e62bd3b..7d1ed81 100644
--- a/includes/hfs/hfsplus.h
+++ b/includes/hfs/hfsplus.h
@@ -505,6 +505,14 @@ typedef struct {
   HFSCatalogNodeID metadataDir;
 } Volume;
 
+/* Size in bytes of `blocks` allocation blocks, or equivalently the byte
+ * offset of block number `blocks`. Block numbers/counts and the block size
+ * are all 32-bit on disk, so the product must be formed in 64 bits or it
+ * wraps for volumes of 4 GiB and larger. */
+static inline uint64_t hfsBlocksToBytes(const Volume* volume, uint32_t blocks) {
+  return (uint64_t)blocks * volume->volumeHeader->blockSize;
+}
+
 
 typedef struct {
 	HFSCatalogNodeID id;
