diff --git a/configure.ac b/configure.ac
index cb4cec6..6db7aa8 100644
--- a/configure.ac
+++ b/configure.ac
@@ -89,7 +89,6 @@ AC_CHECK_HEADERS([ \
     linux/serial.h \
     netdb.h \
     netinet/in.h \
-    netinet/ip.h \
     netinet/tcp.h \
     sys/ioctl.h \
     sys/params.h \
@@ -101,6 +100,12 @@ AC_CHECK_HEADERS([ \
     unistd.h \
 ])
 
+# On FreeBSD, netinet/ip.h cannot be compiled standalone: it requires
+# netinet/in.h to be included first, so check it with its prerequisites.
+AC_CHECK_HEADERS([netinet/ip.h], [], [], [[#include <sys/types.h>
+#include <netinet/in.h>
+]])
+
 # Cygwin defines IPTOS_LOWDELAY but can't handle that flag so it's necessary to
 # workaround that problem and Cygwin doesn't define MSG_DONTWAIT.
 AC_CHECK_DECLS([__CYGWIN__])
