Skip the post-RA spill/fill propagation when spills and fills carry their scratch
offset in an OWord message header rather than in the intrinsic. The pass keys spill
slots on that offset, so it treated all of them as one slot, deleted live spills and
fills, and shrank the spill area.

diff --git intel-graphics-compiler/visa/SpillManagerGMRF.cpp intel-graphics-compiler/visa/SpillManagerGMRF.cpp
index 8dc6d5862..02497b67c 100644
--- intel-graphics-compiler/visa/SpillManagerGMRF.cpp
+++ intel-graphics-compiler/visa/SpillManagerGMRF.cpp
@@ -6053,6 +6053,18 @@ unsigned GlobalRA::spillFillPropagation() {
   if (useLscForScatterSpill)
     return 0;
 
+  // The pass identifies spill slots by the offset in the intrinsics. OWord
+  // block spills and fills may carry theirs only in a message header, so the
+  // pass can neither tell their slots apart nor bound the spill area. Skip it
+  // and leave the caller's spill area size unchanged.
+  for (G4_BB *bb : kernel.fg)
+    for (G4_INST *inst : *bb)
+      if ((inst->isSpillIntrinsic() &&
+           !inst->asSpillIntrinsic()->isOffsetValid()) ||
+          (inst->isFillIntrinsic() &&
+           !inst->asFillIntrinsic()->isOffsetValid()))
+        return UINT_MAX;
+
   SpillFillPropagation sfp(kernel, builder, *this);
   sfp.run();
   return sfp.getMaxSpillAreaOffset();
