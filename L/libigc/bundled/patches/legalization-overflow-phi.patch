+// Replace a PHI of an aggregate by one PHI per element. The incoming values become extracts
+// at the end of the incoming blocks, and the PHI's extract users are redirected to the element
+// PHIs. Other users (another PHI, a select) get the aggregate rebuilt from the element PHIs.
+void Legalization::splitAggregatePHI(PHINode &phi) {
+  StructType *STy = dyn_cast<StructType>(phi.getType());
+  if (!STy)
+    return;
+  const unsigned numElements = STy->getNumElements();
+  const unsigned numIncoming = phi.getNumIncomingValues();
+
+  SmallVector<PHINode *, 2> elementPHIs;
+  for (unsigned i = 0; i < numElements; ++i) {
+    PHINode *elementPHI = PHINode::Create(STy->getElementType(i), numIncoming, "", &phi);
+    elementPHI->setDebugLoc(phi.getDebugLoc());
+    for (unsigned j = 0; j < numIncoming; ++j) {
+      BasicBlock *incomingBB = phi.getIncomingBlock(j);
+      IGCLLVM::IRBuilder<> builder(incomingBB->getTerminator());
+      elementPHI->addIncoming(builder.CreateExtractValue(phi.getIncomingValue(j), i), incomingBB);
+    }
+    elementPHIs.push_back(elementPHI);
+  }
+
+  Value *aggregate = nullptr;
+  SmallVector<User *, 4> users(phi.user_begin(), phi.user_end());
+  for (User *U : users) {
+    if (auto *extract = dyn_cast<ExtractValueInst>(U)) {
+      if (extract->getNumIndices() == 1) {
+        extract->replaceAllUsesWith(elementPHIs[extract->getIndices()[0]]);
+        m_instructionsToRemove.push_back(extract);
+        continue;
+      }
+    }
+    if (!aggregate) {
+      Instruction *insertPt = phi.getParent()->getFirstNonPHI();
+      aggregate = UndefValue::get(STy);
+      for (unsigned i = 0; i < numElements; ++i)
+        aggregate = InsertValueInst::Create(aggregate, elementPHIs[i], {i}, "", insertPt);
+    }
+    U->replaceUsesOfWith(&phi, aggregate);
+  }
+
+  // The PHI is erased at the end of the pass together with its extracts, which still refer to
+  // it. Drop its incoming values now so that visiting another of its incoming intrinsics does
+  // not split (and queue for removal) the same PHI again.
+  for (unsigned j = 0; j < numIncoming; ++j)
+    phi.setIncomingValue(j, UndefValue::get(STy));
+  m_instructionsToRemove.push_back(&phi);
+
+  // PHIs of i1 are not legal; the visitor will not come back to blocks it has already
+  // passed, so legalize the new element PHIs here.
+  for (PHINode *elementPHI : elementPHIs)
+    visitPHINode(*elementPHI);
+}
