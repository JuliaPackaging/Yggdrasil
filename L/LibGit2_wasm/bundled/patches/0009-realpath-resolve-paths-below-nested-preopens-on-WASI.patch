From f142fc100570b88fcfc0e78476788b0a6f083045 Mon Sep 17 00:00:00 2001
From: Panagiotis Georgakopoulos <8681967+pankgeorg@users.noreply.github.com>
Date: Thu, 5 Nov 2026 22:46:18 +0000
Subject: [PATCH 09/10] realpath: resolve paths below nested preopens on WASI

wasi-libc's realpath() calls readlink() on every prefix of the path, and a
prefix that is not inside a preopened directory fails: "/a" for the preopen
"/a/b". So with a preopen of more than one path component, nothing below it
resolves, and `git_repository_init`, `git_repository_open` and others fail
with "failed to resolve path".

When realpath() fails that way on WASI, resolve the path lexically (`.` and
`..`, relative to the working directory) and check that it exists. Symbolic
links are not resolved in that case.
---
 src/util/unix/realpath.c | 71 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 70 insertions(+), 1 deletion(-)

diff --git a/src/util/unix/realpath.c b/src/util/unix/realpath.c
index 2565e2e..7ac64b0 100644
--- a/src/util/unix/realpath.c
+++ b/src/util/unix/realpath.c
@@ -14,12 +14,81 @@
 #include <fcntl.h>
 #include <unistd.h>
 
+#ifdef __wasi__
+# include <errno.h>
+# include <string.h>
+# include <sys/stat.h>
+
+/*
+ * wasi-libc's realpath() calls readlink() on every prefix of the path, and
+ * a prefix that is not inside a preopened directory fails: "/a" for the
+ * preopen "/a/b", so that nothing below a preopen of more than one path
+ * component resolves. Resolve such a path lexically instead (`.` and `..`,
+ * relative to the working directory; symbolic links are left as they are),
+ * if it exists.
+ */
+static char *wasi_lexical_realpath(const char *pathname, char *resolved)
+{
+	char buf[PATH_MAX], out[PATH_MAX];
+	size_t q = 0;
+	const char *p, *e;
+	struct stat st;
+
+	if (pathname[0] == '/') {
+		if (strlen(pathname) >= sizeof(buf)) goto toolong;
+		strcpy(buf, pathname);
+	} else {
+		if (!getcwd(buf, sizeof(buf))) return NULL;
+		if (strlen(buf) + 1 + strlen(pathname) >= sizeof(buf)) goto toolong;
+		strcat(buf, "/");
+		strcat(buf, pathname);
+	}
+
+	for (p = buf; *p; p = e) {
+		size_t l;
+		while (*p == '/') p++;
+		for (e = p; *e && *e != '/'; e++);
+		l = (size_t)(e - p);
+		if (l == 0 || (l == 1 && p[0] == '.'))
+			continue;
+		if (l == 2 && p[0] == '.' && p[1] == '.') {
+			while (q > 0 && out[q - 1] != '/') q--;
+			if (q > 0) q--;
+			continue;
+		}
+		if (q + 1 + l >= sizeof(out)) goto toolong;
+		out[q++] = '/';
+		memcpy(out + q, p, l);
+		q += l;
+	}
+	if (q == 0) out[q++] = '/';
+	out[q] = '\0';
+
+	if (stat(out, &st) < 0)
+		return NULL;
+
+	if (!resolved)
+		return git__strdup(out);
+	memcpy(resolved, out, q + 1);
+	return resolved;
+
+toolong:
+	errno = ENAMETOOLONG;
+	return NULL;
+}
+#endif
+
 char *p_realpath(const char *pathname, char *resolved)
 {
 	char *result;
 
-	if ((result = realpath(pathname, resolved)) == NULL)
+	if ((result = realpath(pathname, resolved)) == NULL) {
+#ifdef __wasi__
+		if (errno == ENOENT || errno == ENOTCAPABLE)
+			return wasi_lexical_realpath(pathname, resolved);
+#endif
 		return NULL;
+	}
 
 #ifdef __OpenBSD__
 	/* The OpenBSD realpath function behaves differently,
