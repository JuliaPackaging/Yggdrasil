From 19bbaaee88464e4419f01697f9bac13fa16e7956 Mon Sep 17 00:00:00 2001
From: Panagiotis Georgakopoulos <8681967+pankgeorg@users.noreply.github.com>
Date: Thu, 5 Nov 2026 21:36:01 +0000
Subject: [PATCH 02/10] streams: no default socket stream on WASI

WASI preview 1 has no sockets (no `<netdb.h>`, `<sys/socket.h>` or
`<netinet/*>`). Build the socket stream there without the BSD socket code:
the default stream fails with an error that says to register a stream
(`git_stream_register`) or a transport (`git_transport_register`). A custom
`GIT_STREAM_STANDARD` registration is still honoured.
---
 src/libgit2/streams/socket.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/libgit2/streams/socket.c b/src/libgit2/streams/socket.c
index d064f86..4125e20 100644
--- a/src/libgit2/streams/socket.c
+++ b/src/libgit2/streams/socket.c
@@ -12,7 +12,9 @@
 #include "runtime.h"
 #include "stream.h"
 
-#ifndef _WIN32
+#if defined(__wasi__)
+/* WASI preview 1 has no sockets: see default_socket_stream_new below */
+#elif !defined(_WIN32)
 # include <sys/types.h>
 # include <sys/socket.h>
 # include <sys/select.h>
@@ -35,6 +37,7 @@
 int git_socket_stream__connect_timeout = 0;
 int git_socket_stream__timeout = 0;
 
+#ifndef __wasi__
 #ifdef GIT_WIN32
 static void net_set_error(const char *str)
 {
@@ -389,6 +392,14 @@ static int default_socket_stream_new(
 	*out = (git_stream *) st;
 	return 0;
 }
+#else /* __wasi__ */
+static int default_socket_stream_new(git_stream **out, const char *host, const char *port)
+{
+	GIT_UNUSED(out); GIT_UNUSED(host); GIT_UNUSED(port);
+	git_error_set(GIT_ERROR_NET, "WASI has no sockets: register a transport (git_transport_register) or a stream (git_stream_register)");
+	return -1;
+}
+#endif /* __wasi__ */
 
 int git_socket_stream_new(
 	git_stream **out,
