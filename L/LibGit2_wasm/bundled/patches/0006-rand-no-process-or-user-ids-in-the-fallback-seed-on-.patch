From 979d959e447004c260c1fd03dd6a210b8731da3b Mon Sep 17 00:00:00 2001
From: Panagiotis Georgakopoulos <8681967+pankgeorg@users.noreply.github.com>
Date: Thu, 5 Nov 2026 21:36:11 +0000
Subject: [PATCH 06/10] rand: no process or user ids in the fallback seed on
 WASI

WASI has no `getpid`, `getppid`, `getpgid`, `getsid`, `getuid` or `getgid`.
The seed comes from `getentropy` there (which WASI provides and CMake
detects); the time-based fallback leaves the ids out.
---
 src/util/rand.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/util/rand.c b/src/util/rand.c
index 2b137a5..f0d1134 100644
--- a/src/util/rand.c
+++ b/src/util/rand.c
@@ -112,12 +112,14 @@ GIT_INLINE(int) getseed(uint64_t *seed)
 	*seed |= ((uint64_t)tv.tv_usec << 40);
 	*seed |= ((uint64_t)tv.tv_sec);
 
+#ifndef __wasi__   /* WASI has no process or user ids */
 	*seed ^= ((uint64_t)getpid() << 48);
 	*seed ^= ((uint64_t)getppid() << 32);
 	*seed ^= ((uint64_t)getpgid(0) << 28);
 	*seed ^= ((uint64_t)getsid(0) << 16);
 	*seed ^= ((uint64_t)getuid() << 8);
 	*seed ^= ((uint64_t)getgid());
+#endif
 
 # if defined(GIT_RAND_GETLOADAVG)
 	getloadavg(loadavg, 3);
