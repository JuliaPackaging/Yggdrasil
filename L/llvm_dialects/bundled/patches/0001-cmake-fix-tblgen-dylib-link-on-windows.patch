From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Valentin Churavy <v.churavy@gmail.com>
Date: Thu, 3 Sep 2026 00:14:08 +0200
Subject: [PATCH] cmake: fix linking llvm-dialects-tblgen against the LLVM
 dylib on Windows

When LLVM_LINK_LLVM_DYLIB is set, link the TableGen archive by file instead
of through its imported target. The target's link interface also adds the
static LLVMSupport archive; on Windows a linker then resolves symbols that
the dylib only exports as data (e.g. the vtable of llvm::cl::Option, whose
import library entry is just __imp_) from that archive rather than
auto-importing them, and the archive's remaining definitions clash with the
import library:

  ld.lld: error: duplicate symbol: llvm::cl::Option::setArgStr(llvm::StringRef)
  >>> defined at libLLVMSupport.a(CommandLine.cpp.obj)
  >>> defined at libLLVM-22jl.dll.a(libLLVM-22jl.dll)

Also link the LLVM libraries after llvm_dialects_tablegen: an import library
is an archive, so a single-pass linker (GNU ld) has to see it after every
object that references it.
---
 CMakeLists.txt | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d0ae6d2..72bf389 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -126,14 +126,26 @@ else()
         # TableGen component libraries statically; the static LLVMSupport
         # archive may not be linkable with a toolchain that differs from
         # the one that produced the LLVM distribution.
-        target_link_libraries(llvm-dialects-tblgen PRIVATE LLVM LLVMTableGen)
+        #
+        # Link the TableGen archive by file rather than through its imported
+        # target: the target's link interface would drag in the static
+        # LLVMSupport archive as well. On Windows, symbols that the dylib
+        # only exports as data (vtables, for instance) are then resolved from
+        # that archive instead of being auto-imported, and the archive's
+        # other definitions clash with the import library.
+        set(llvm_dialects_tblgen_llvm_libs $<TARGET_FILE:LLVMTableGen> LLVM)
     else()
-        llvm_map_components_to_libnames(llvm_libs ${llvm_deps})
-        target_link_libraries(llvm-dialects-tblgen PRIVATE ${llvm_libs})
+        llvm_map_components_to_libnames(llvm_dialects_tblgen_llvm_libs ${llvm_deps})
     endif()
 endif()
 
 target_link_libraries(llvm-dialects-tblgen PRIVATE llvm_dialects_tablegen)
+if(NOT llvm_dialects_is_in_llvm_build_tree)
+    # The LLVM libraries go after llvm_dialects_tablegen, which depends on
+    # them. On Windows the dylib's import library is an archive too, so a
+    # single-pass linker must see it after everything that references it.
+    target_link_libraries(llvm-dialects-tblgen PRIVATE ${llvm_dialects_tblgen_llvm_libs})
+endif()
 set_compiler_options(llvm-dialects-tblgen)
 
 # The llvm_dialects library build depends on llvm/IR/Attributes.inc
