+                             + (Vz(k  ,i  ,j  ) - Vz(k-1,i  ,j  )) * r20z )
+                    rx  = real( (Vz(k  ,i  ,j+1) - Vz(k  ,i  ,j  )) * r20y &
+                             - (Vy(k+1,i  ,j  ) - Vy(k  ,i  ,j  )) * r20z )
+                    ry  = real( (Vx(k+1,i  ,j  ) - Vx(k  ,i  ,j  )) * r20z &
