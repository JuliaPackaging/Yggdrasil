+                    sbuf(0*nloc + r) = div * UC * M0 * 1e-3
+                    sbuf(1*nloc + r) = rx  * UC * M0 * 1e-3
+                    sbuf(2*nloc + r) = ry  * UC * M0 * 1e-3
+                    sbuf(3*nloc + r) = rz  * UC * M0 * 1e-3
+                end do
+            end do
