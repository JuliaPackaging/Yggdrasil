+    subroutine wbuf_vol_ps(it)
+        integer, intent(in) :: it
+
+        integer :: ii, jj, kk, i, j, k
+        integer :: r, err
+        integer :: hdr_i(6)
+        integer :: nxL, nyL, nzL, nloc
+        integer :: stt(4), cnt(4)
+        real(SP) :: div, rx, ry, rz
+        real(SP), allocatable :: sbuf(:)
