Fix building nauty for a different system than the one compiling it

Three separate problems, all in configure.ac:

1. configure works out whether the CPU supports the popcnt and lzcnt
   instructions by running a small test program. That is impossible when
   building for another system, and configure gives up entirely. Assume the
   instructions are absent in that case, which is what --enable-generic wants
   anyway.

2. configure decides whether it is building for Windows by looking at the
   machine doing the compiling rather than the one being compiled for, so a
   Linux-to-Windows build never takes the Windows path and no DLL is produced.
   Look at the target instead, and recognise mingw and msys as well as cygwin.

3. Shared libraries are named with the version number in them, which has no
   Windows equivalent. Add a setting so the makefile can leave the version out
   on Windows and keep the existing names everywhere else.

--- a/configure.ac
+++ b/configure.ac
@@ -165,8 +165,8 @@
 esac
 AC_SUBST(is_ARM64)
 
-case "$build" in
-  *cygwin*)
+case "$host" in
+  *cygwin*|*mingw*|*msys*)
      is_cygwin=1 ;;
   *)
      is_cygwin=0 ;;
@@ -352,7 +352,7 @@
 dnl --check if popcnt instruction is available and desired
 AC_MSG_CHECKING(if popcnt instruction is available and requested)
 AC_RUN_IFELSE([AC_LANG_PROGRAM([],[[if (__builtin_cpu_supports("popcnt")) return 0; else return 1;]])],
-  popsup=1,popsup=0)
+  popsup=1,popsup=0,popsup=0)
 
 AS_IF([test "$allow_popcnt" -eq 1],
       [have_hwpopcnt=$popsup
@@ -457,7 +457,7 @@
 dnl --check if lzcnt instruction is available and requested
 AC_MSG_CHECKING(if lzcnt instruction is available and requested)
 AC_RUN_IFELSE([AC_LANG_PROGRAM([],[[if (__builtin_cpu_supports("bmi")) return 0; else return 1;]])],
-  lzsup=1,lzsup=0)
+  lzsup=1,lzsup=0,lzsup=0)
 AS_IF([test "$allow_clz" -eq 1],
       [have_hwlzcnt=$lzsup
 test -f /proc/cpuinfo && $EGREP -i "abm|bmi1" /proc/cpuinfo >/dev/null && have_hwlzcnt=1 
@@ -534,8 +534,13 @@
       [ AC_PATH_PROGS(sort_prog,[gsort sort],no_sort_found,
              [/usr/bin$PATH_SEPARATOR/bin$PATH_SEPARATOR$PATH])],
       [ AC_CHECK_PROGS(sort_prog,[gsort sort],no_sort_found)])
-AS_IF([test $is_cygwin -eq 1],[cygnoun="-no-undefined"],[cygnoun=])
+AS_IF([test $is_cygwin -eq 1],
+      [cygnoun="-no-undefined"
+       libversionflag="-avoid-version"],
+      [cygnoun=
+       libversionflag="-release $PACKAGE_VERSION"])
 AC_SUBST(cygnoun)
+AC_SUBST(libversionflag)
 
 AC_MSG_CHECKING(if sort supports the -k switch)
 AS_IF([{ $sort_prog -k "2,3" </dev/null >/dev/null 2>&1 ; }],
