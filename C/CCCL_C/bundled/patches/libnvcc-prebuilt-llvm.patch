-if (DEFINED HOSTJIT_LLVM_VERSION AND NOT DEFINED LIBNVCC_LLVM_VERSION)
-  set(_libnvcc_llvm_version_default "${HOSTJIT_LLVM_VERSION}")
+# LIBNVCC_LLVM_PREFIX selects a prebuilt LLVM/Clang/LLD installation (with static
+# libraries and CMake package files) instead of fetching and building LLVM.
+set(LIBNVCC_LLVM_PREFIX "" CACHE PATH "Prebuilt LLVM/Clang/LLD installation to link against")
+
+if (LIBNVCC_LLVM_PREFIX)
+  find_package(LLVM REQUIRED CONFIG PATHS "${LIBNVCC_LLVM_PREFIX}/lib/cmake/llvm" NO_DEFAULT_PATH)
+  find_package(Clang REQUIRED CONFIG PATHS "${LIBNVCC_LLVM_PREFIX}/lib/cmake/clang" NO_DEFAULT_PATH)
+  find_package(LLD REQUIRED CONFIG PATHS "${LIBNVCC_LLVM_PREFIX}/lib/cmake/lld" NO_DEFAULT_PATH)
+  set(_libnvcc_llvm_include_dirs ${LLVM_INCLUDE_DIRS} ${CLANG_INCLUDE_DIRS} ${LLD_INCLUDE_DIRS})
+
+  # An LLVM built with LLVM_LINK_LLVM_DYLIB exports Clang and LLD libraries that link
+  # against the LLVM shared library. libnvcc must not: in a process that already loaded
+  # another LLVM, the dynamic linker would bind libnvcc to that one's symbols. Point
+  # those dependencies at the static component libraries instead.
+  set(_libnvcc_llvm_static_libs "")
+  foreach (_lib IN LISTS LLVM_AVAILABLE_LIBS)
+    if (TARGET ${_lib})
+      # (skipping the few, like LLVMOptDriver, that themselves link the shared library)
+      get_target_property(_type ${_lib} TYPE)
+      get_target_property(_deps ${_lib} INTERFACE_LINK_LIBRARIES)
+      if (_type STREQUAL "STATIC_LIBRARY" AND NOT "LLVM" IN_LIST _deps)
+        list(APPEND _libnvcc_llvm_static_libs ${_lib})
+      endif()
+    endif()
+  endforeach()
+  foreach (_target IN LISTS CLANG_EXPORTED_TARGETS LLD_EXPORTED_TARGETS)
+    if (TARGET ${_target})
+      get_target_property(_deps ${_target} INTERFACE_LINK_LIBRARIES)
+      if (_deps)
+        list(TRANSFORM _deps REPLACE "^LLVM$" "${_libnvcc_llvm_static_libs}")
+        set_target_properties(${_target} PROPERTIES INTERFACE_LINK_LIBRARIES "${_deps}")
+      endif()
+    endif()
+  endforeach()
+  set(_libnvcc_clang_resource_dir "${LIBNVCC_LLVM_PREFIX}/lib/clang/${LLVM_VERSION_MAJOR}")
+  set(_libnvcc_clang_headers_dir "${_libnvcc_clang_resource_dir}/include")
 else()
