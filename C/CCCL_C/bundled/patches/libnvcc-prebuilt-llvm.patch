+if (LIBNVCC_LLVM_PREFIX)
+  # lld's driver initializes every target of the LLVM it was built with, which links in
+  # all of their back-ends. libnvcc only uses X86 and NVPTX, so turn the entry points of
+  # the others into no-ops (hidden, like the rest of the statically linked LLVM).
+  set(_libnvcc_target_stubs "")
+  foreach (_target IN LISTS LLVM_TARGETS_TO_BUILD)
+    if (NOT _target MATCHES "^(X86|NVPTX)$")
+      foreach (_part TargetInfo Target TargetMC AsmPrinter AsmParser Disassembler)
+        string(APPEND _libnvcc_target_stubs
+          "extern \"C\" __attribute__((visibility(\"hidden\"))) void LLVMInitialize${_target}${_part}() {}\n")
+      endforeach()
+    endif()
+  endforeach()
+  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/unused_targets.cpp" "${_libnvcc_target_stubs}")
+  target_sources(libnvcc PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/unused_targets.cpp")
+endif()
+
+target_include_directories(
+  libnvcc
+  PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include
+  PRIVATE ${_libnvcc_llvm_include_dirs}
