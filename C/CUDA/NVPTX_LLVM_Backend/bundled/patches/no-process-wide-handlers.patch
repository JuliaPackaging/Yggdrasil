+  (void)PrevActions;
 }
 
-static void uninstallExceptionOrSignalHandlers() {
-  // Restore the previous signal handlers.
-  for (unsigned i = 0; i != NumSignals; ++i)
-    sigaction(Signals[i], &PrevActions[i], nullptr);
-}
+static void uninstallExceptionOrSignalHandlers() {}
 
 #endif // !_WIN32
 
