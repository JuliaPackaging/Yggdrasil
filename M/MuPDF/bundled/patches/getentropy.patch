--- a/source/fitz/random.c
+++ b/source/fitz/random.c
@@ -1,3 +1,17 @@
+// DISTRIBUTION: getentropy is glibc 2.25's and this build targets 2.17; musl's headers and the
+// 2.17 sysroot's disagree on whether it is declared.
+#include <stdlib.h>
+#include <unistd.h>
+#ifdef __GLIBC__
+#include <features.h>
+#if !__GLIBC_PREREQ(2, 25)
+static int mupdf_unsupported_getentropy(void *buf, size_t len) { (void)buf; (void)len; return -1; }
+#define getentropy mupdf_unsupported_getentropy
+#endif
+#else
+static int mupdf_unsupported_getentropy(void *buf, size_t len) { (void)buf; (void)len; return -1; }
+#define getentropy mupdf_unsupported_getentropy
+#endif
