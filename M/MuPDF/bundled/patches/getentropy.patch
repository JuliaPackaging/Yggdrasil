+#if defined(__linux__) && !defined(__ANDROID__) && \
+	(!defined(__GLIBC__) || __GLIBC__ < 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ < 25))
+/* glibc before 2.25, and older musl, have no getentropy(): read the kernel's random source. */
+#include <stdio.h>
+static int urandom_getentropy(void *buf, size_t len)
+{
+	FILE *f = fopen("/dev/urandom", "rb");
+	size_t n = 0;
+	if (f)
+	{
+		n = fread(buf, 1, len, f);
+		fclose(f);
+	}
+	return n == len ? 0 : -1;
+}
+#define getentropy urandom_getentropy
+#endif
